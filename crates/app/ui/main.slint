import { VerticalBox, HorizontalBox, Button, ComboBox, GroupBox, ListView, StandardButton } from "std-widgets.slint";
import { SettingsPage } from "settings.slint";
import { Sidebar, Page } from "sidebar.slint";
import { LibraryPage, LibraryState, MediaCell, GridRow, InspectorInfo } from "library.slint";
import { EditorPage, EditorState, TimelineClip } from "editor.slint";

export { Page, LibraryState, MediaCell, GridRow, InspectorInfo, EditorState, TimelineClip }

/// Strings Rust needs in the current UI language.
export global Strings {
    out property <string> system-language: @tr("System language");
    out property <string> untitled-project: @tr("Untitled slideshow");
    in-out property <int> count;
    out property <string> added-clips: @tr("Added {} photos to the timeline", self.count);
    out property <string> skipped-items: @tr("{} items skipped (only photos with metadata can be added yet)", self.count);
    out property <string> ffmpeg-missing: @tr("ffmpeg was not found. Install it or place it next to the app.");
}

export component MainWindow inherits Window {
    title: @tr("ClipForge");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;
    icon: @image-url("../../../assets/icons/256x256.png");

    in-out property <Page> page: Page.library;

    // Settings state, owned by Rust.
    in-out property <int> language-index: 0;
    in property <[string]> language-options: [];
    in property <string> app-version: "";

    callback quit();
    callback language-selected(int);

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); activated => { EditorState.new-project(); root.page = Page.editor; } }
            MenuItem { title: @tr("Open Project…"); activated => { EditorState.open-project(); root.page = Page.editor; } }
            MenuItem { title: @tr("Save Project"); activated => { EditorState.save-project(); } }
            MenuItem { title: @tr("Save Project As…"); activated => { EditorState.save-project-as(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Export Video…"); activated => { root.page = Page.editor; EditorState.export-open = true; } }
            MenuSeparator {}
            MenuItem { title: @tr("Add files to library…"); activated => { LibraryState.add-files(); } }
            MenuItem { title: @tr("Add folder to library…"); activated => { LibraryState.add-folder(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Settings"); activated => { root.page = Page.settings; } }
            MenuSeparator {}
            MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); enabled: EditorState.can-undo; activated => { EditorState.undo(); } }
            MenuItem { title: @tr("Redo"); enabled: EditorState.can-redo; activated => { EditorState.redo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Select All Clips"); activated => { EditorState.select-all(); } }
            MenuItem { title: @tr("Remove Selected Clips"); activated => { EditorState.delete-selected(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Library"); activated => { root.page = Page.library; } }
            MenuItem { title: @tr("Editor"); activated => { root.page = Page.editor; } }
        }
    }

    HorizontalLayout {
        Sidebar {
            page <=> root.page;
        }
        Rectangle {
            background: #1e1e1e;
            if root.page == Page.library : LibraryPage { }
            if root.page == Page.editor : EditorPage { }
            if root.page == Page.settings : SettingsPage {
                language-index <=> root.language-index;
                language-options: root.language-options;
                app-version: root.app-version;
                language-selected(i) => { root.language-selected(i); }
            }
        }
    }
}

