import { Button } from "std-widgets.slint";
import { SettingsPage } from "settings.slint";
import { LibraryPage, LibraryState, MediaCell, GridRow, InspectorInfo } from "library.slint";
import { EditorPage, EditorState, TimelineClip, StripRect } from "editor.slint";
import { Shell } from "shell.slint";

export { LibraryState, MediaCell, GridRow, InspectorInfo, EditorState, TimelineClip, StripRect, Shell }

/// Strings Rust needs in the current UI language.
export global Strings {
    out property <string> system-language: @tr("System language");
    out property <string> untitled-project: @tr("Untitled slideshow");
    in-out property <int> count;
    out property <string> added-clips: @tr("Added {} photos to the timeline", self.count);
    out property <string> skipped-items: @tr("{} items skipped (only photos with metadata can be added yet)", self.count);
    out property <string> ffmpeg-missing: @tr("ffmpeg was not found. Install it or place it next to the app.");
}


export component MainWindow inherits Window {
    title: @tr("ClipForge");
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 560px;
    icon: @image-url("../../../assets/icons/256x256.png");

    // Settings state, owned by Rust.
    in-out property <int> language-index: 0;
    in property <[string]> language-options: [];
    in property <string> app-version: "";

    callback quit();
    callback language-selected(int);
    /// Timeline strip geometry, read by Rust during library drags.
    out property <StripRect> editor-strip-rect: editor.strip-rect;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); activated => { EditorState.new-project(); } }
            MenuItem { title: @tr("Open Project…"); activated => { EditorState.open-project(); } }
            MenuItem { title: @tr("Save Project"); activated => { EditorState.save-project(); } }
            MenuItem { title: @tr("Save Project As…"); activated => { EditorState.save-project-as(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Export Video…"); activated => { EditorState.export-open = true; } }
            MenuSeparator {}
            MenuItem { title: @tr("Add files to library…"); activated => { LibraryState.add-files(); } }
            MenuItem { title: @tr("Add folder to library…"); activated => { LibraryState.add-folder(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Settings"); activated => { Shell.settings-open = true; } }
            MenuSeparator {}
            MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); enabled: EditorState.can-undo; activated => { EditorState.undo(); } }
            MenuItem { title: @tr("Redo"); enabled: EditorState.can-redo; activated => { EditorState.redo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Select All Clips"); activated => { EditorState.select-all(); } }
            MenuItem { title: @tr("Remove Selected Clips"); activated => { EditorState.delete-selected(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: Shell.library-visible ? @tr("Hide Library") : @tr("Show Library");
                activated => { Shell.library-visible = !Shell.library-visible; }
            }
        }
    }

    HorizontalLayout {
        if Shell.library-visible : LibraryPage {
            width: Shell.library-width;
        }
        // Divider: drag to resize the library panel.
        divider := Rectangle {
            width: 6px;
            background: divider-touch.has-hover || divider-touch.pressed ? #3d5afe : #101114;
            divider-touch := TouchArea {
                mouse-cursor: Shell.library-visible ? MouseCursor.col-resize : MouseCursor.default;
                moved => {
                    if self.pressed && Shell.library-visible {
                        // The panel starts at the window's left edge, so the
                        // pointer's window x is the new width (stable while the
                        // divider itself moves under the pointer).
                        Shell.library-width = max(260px, min(root.width - 600px, divider.absolute-position.x + self.mouse-x - 3px));
                    }
                }
            }
        }
        editor := EditorPage {
            horizontal-stretch: 1;
        }
    }

    if Shell.drag-active : Rectangle {
        x: Shell.drag-x + 12px;
        y: Shell.drag-y + 12px;
        width: 150px;
        height: 32px;
        border-radius: 8px;
        background: Shell.drag-over-timeline ? #3d5afe : #40444d;
        Text {
            text: Shell.drag-count == 1 ? @tr("1 photo") : @tr("{} photos", Shell.drag-count);
            color: white;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    if Shell.settings-open : Rectangle {
        background: #000000aa;
        TouchArea { clicked => { Shell.settings-open = false; } }
        Rectangle {
            width: 520px;
            height: 380px;
            border-radius: 12px;
            background: #1e1e1e;
            clip: true;
            TouchArea { }
            SettingsPage {
                language-index <=> root.language-index;
                language-options: root.language-options;
                app-version: root.app-version;
                language-selected(i) => { root.language-selected(i); }
            }
            Button {
                text: @tr("Close");
                x: parent.width - self.width - 16px;
                y: parent.height - self.height - 16px;
                clicked => { Shell.settings-open = false; }
            }
        }
    }
}
