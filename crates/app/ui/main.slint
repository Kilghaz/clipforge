import { Button, Palette } from "std-widgets.slint";
import { SettingsPage } from "settings.slint";
import { LibraryPage, LibraryState, MediaCell, GridRow, InspectorInfo } from "library.slint";
import { EditorPage, EditorState, TimelineClip, StripRect } from "editor.slint";
import { Shell } from "shell.slint";
import { GalleryWindow } from "gallery.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, DialogFrame, DialogButtons, Title, Caption } from "components.slint";

export { LibraryState, MediaCell, GridRow, InspectorInfo, EditorState, TimelineClip, StripRect, Shell, GalleryWindow }

/// Strings Rust needs in the current UI language.
export global Strings {
    out property <string> system-language: @tr("System language");
    out property <string> untitled-project: @tr("Untitled slideshow");
    in-out property <int> count;
    out property <string> added-clips: @tr("Added {} items to the timeline", self.count);
    out property <string> skipped-items: @tr("{} items skipped (audio files and items without metadata cannot be added yet)", self.count);
    out property <string> ffmpeg-missing: @tr("ffmpeg was not found. Install it or place it next to the app.");
    out property <string> shuffled-transitions: @tr("Shuffled transitions on {} clips", self.count);
    out property <string> shuffled-motion: @tr("Shuffled motion on {} photos", self.count);
}


export component MainWindow inherits Window {
    // Body size for everything without an explicit size, so std widgets
    // (Button behind ActionButton, ComboBox, Switch, LineEdit) match our
    // own controls. Without it Slint falls back to 12 px (DESIGN.md §2).
    default-font-size: Theme.font-body;
    title: @tr("ClipForge");
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 560px;
    icon: @image-url("../../../assets/icons/256x256.png");
    background: Theme.surface-window;
    // Dark only (ADR-0009); the style's palette follows.
    init => { Palette.color-scheme = ColorScheme.dark; Shell.library-max-width = self.width - 640px; }
    changed width => { Shell.library-max-width = self.width - 640px; }

    // Settings state, owned by Rust.
    in-out property <int> language-index: 0;
    in property <[string]> language-options: [];
    in property <string> app-version: "";

    callback quit();
    callback language-selected(int);
    /// Timeline strip geometry, read by Rust during library drags.
    out property <StripRect> editor-strip-rect: editor.strip-rect;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New project"); activated => { EditorState.new-project(); } }
            MenuItem { title: @tr("Open project…"); activated => { EditorState.open-project(); } }
            MenuItem { title: @tr("Save project"); activated => { EditorState.save-project(); } }
            MenuItem { title: @tr("Save project as…"); activated => { EditorState.save-project-as(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Export video…"); enabled: EditorState.clip-count > 0; activated => { EditorState.export-open = true; } }
            MenuSeparator {}
            MenuItem { title: @tr("Add files to library…"); activated => { LibraryState.add-files(); } }
            MenuItem { title: @tr("Add folder to library…"); activated => { LibraryState.add-folder(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Settings…"); enabled: !EditorState.export-open; activated => { Shell.settings-open = true; } }
            MenuSeparator {}
            MenuItem { title: Shell.macos ? @tr("Quit") : @tr("Exit"); activated => { root.quit(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); enabled: EditorState.can-undo; activated => { EditorState.undo(); } }
            MenuItem { title: @tr("Redo"); enabled: EditorState.can-redo; activated => { EditorState.redo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Select all clips"); enabled: EditorState.clip-count > 0; activated => { EditorState.select-all(); } }
            MenuItem { title: @tr("Remove selected clips"); enabled: EditorState.selected-count > 0; activated => { EditorState.delete-selected(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: Shell.library-visible ? @tr("Hide library") : @tr("Show library");
                activated => { Shell.library-visible = !Shell.library-visible; }
            }
        }
    }

    HorizontalLayout {
        if Shell.library-visible : LibraryPage {
            // Never squeeze the editor below ~640 px (inspector + preview).
            width: max(280px, min(Shell.library-width, Shell.library-max-width));
        }
        // Divider: 1 px line with an 8 px grab area; drag to resize the
        // library panel, double-click to reset (Fluent "SplitView").
        divider := Rectangle {
            width: Shell.library-visible ? 8px : 0px;
            background: Theme.surface-window;
            Rectangle {
                width: divider-touch.has-hover || divider-touch.pressed ? 3px : 1px;
                height: parent.height;
                x: (parent.width - self.width) / 2;
                background: divider-touch.has-hover || divider-touch.pressed ? Theme.accent : Theme.border;
                animate width, background { duration: Theme.motion-fast; }
            }
            divider-touch := TouchArea {
                enabled: Shell.library-visible;
                mouse-cursor: MouseCursor.col-resize;
                double-clicked => { Shell.library-width = 380px; }
                moved => {
                    if self.pressed {
                        // The panel starts at the window's left edge, so the
                        // pointer's window x is the new width (stable while the
                        // divider itself moves under the pointer).
                        Shell.library-width = max(280px, min(root.width - 640px, divider.absolute-position.x + self.mouse-x - 4px));
                    }
                }
            }
        }
        editor := EditorPage {
            horizontal-stretch: 1;
        }
    }

    // Drag ghost: what is being dragged and whether the drop will land.
    if Shell.drag-active : Rectangle {
        x: Shell.drag-x + Theme.space-m;
        y: Shell.drag-y + Theme.space-m;
        height: Theme.control-height;
        width: ghost.preferred-width + 2 * Theme.space-m;
        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Shell.drag-over-timeline ? Theme.accent : Theme.border;
        background: Shell.drag-over-timeline ? Theme.accent : Theme.surface-card;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        ghost := HorizontalLayout {
            padding-left: Theme.space-m;
            padding-right: Theme.space-m;
            spacing: Theme.space-s;
            alignment: center;
            Icon { source: Icons.image-multiple; size: Theme.icon-s; color: Shell.drag-over-timeline ? Palette.accent-foreground : Theme.text; }
            Text {
                text: Shell.drag-count == 1 ? @tr("1 item") : @tr("{} items", Shell.drag-count);
                color: Shell.drag-over-timeline ? Palette.accent-foreground : Theme.text;
                font-size: Theme.font-secondary;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }
    }

    if Shell.settings-open : DialogFrame {
        title: @tr("Settings");
        dialog-width: 520px;
        dismissed => { Shell.settings-open = false; }
        accepted => { Shell.settings-open = false; }
        SettingsPage {
            language-index <=> root.language-index;
            language-options: root.language-options;
            app-version: root.app-version;
            language-selected(i) => { root.language-selected(i); }
        }
        DialogButtons {
            macos: Shell.macos;
            primary-text: @tr("Close");
            primary => { Shell.settings-open = false; }
        }
    }
}
