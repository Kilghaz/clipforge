// Shared ClipForge components (docs/ux/DESIGN.md §4). Each one copies the
// states and behaviour of its Fluent / Spectrum reference and only uses
// `Theme` tokens and `Palette` colours.
import { Button } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

/// Single-colour icon, recoloured to the given brush (Fluent iconography).
export component Icon inherits Image {
    in property <length> size: Theme.icon-m;
    in property <brush> color: Theme.text;
    width: root.size;
    height: root.size;
    colorize: root.color;
    image-fit: contain;
}

/// Icon-only button, built directly (the std `Button` reserves room for a
/// text label and its 12 px padding, so a 20 px icon never centres in 32 px).
/// States and metrics follow Fluent "Button": 32 × 32, radius 4, 1 px border,
/// hover / pressed / disabled / checked, visible focus ring, tooltip and
/// accessible label always present.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> checkable;
    /// Borderless until hovered (Fluent command-bar buttons).
    in property <bool> quiet;
    in-out property <bool> checked;
    callback clicked;
    property <bool> accent: root.primary || root.checked;
    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: root.accent || root.quiet ? transparent : Theme.border;
    background: root.accent ? Theme.accent : (root.quiet ? transparent : Theme.surface-card);
    animate background { duration: Theme.motion-fast; }
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { touch.clicked(); }
    forward-focus: focus;

    states [
        disabled when !root.enabled : {
            root.background: root.accent ? Theme.accent-disabled : Theme.control-disabled;
            root.border-color: root.accent ? transparent : Theme.border;
            glyph.color: root.accent ? Theme.on-accent-disabled : Theme.text-disabled;
        }
        pressed when touch.pressed : {
            root.background: root.accent ? Theme.accent-pressed : Theme.control-pressed;
            glyph.color: root.accent ? Theme.on-accent : Theme.text-secondary;
        }
        hover when touch.has-hover : {
            root.background: root.accent ? Theme.accent-hover : Theme.control-hover;
        }
    ]

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { touch.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if root.checkable { root.checked = !root.checked; }
            root.clicked();
        }
    }
    glyph := Icon {
        source: root.icon;
        size: Theme.icon-m;
        color: root.accent ? Theme.on-accent : Theme.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    // Focus ring outside the control (Fluent "FocusBorder").
    if focus.has-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

/// One option of a small set (duration presets): text version of
/// `IconButton`. The std `Button` checked state differs per style and is
/// unreadable in cupertino; this one uses our tokens (Spectrum "Action group").
export component ChoiceButton inherits Rectangle {
    in property <string> text;
    /// Spoken name when `text` is an abbreviation ("4 s" → "4 seconds").
    in property <string> accessible-text;
    in property <bool> enabled: true;
    in property <bool> selected;
    /// False inside a ChoiceGroup: the group is the single tab stop.
    in property <bool> focusable: true;
    /// Draw the focus ring on the group's behalf.
    in property <bool> show-focus;
    callback clicked;
    height: Theme.control-height;
    min-width: max(40px, label.preferred-width + 2 * Theme.space-m);
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: root.selected ? transparent : Theme.border;
    background: root.selected ? Theme.accent : Theme.surface-card;
    animate background { duration: Theme.motion-fast; }
    accessible-role: button;
    accessible-label: root.accessible-text != "" ? root.accessible-text : root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { touch.clicked(); }
    forward-focus: focus;

    states [
        disabled when !root.enabled : {
            root.background: root.selected ? Theme.accent-disabled : Theme.control-disabled;
            label.color: root.selected ? Theme.on-accent-disabled : Theme.text-disabled;
        }
        pressed when touch.pressed : {
            root.background: root.selected ? Theme.accent-pressed : Theme.control-pressed;
        }
        hover when touch.has-hover : {
            root.background: root.selected ? Theme.accent-hover : Theme.control-hover;
        }
    ]

    focus := FocusScope {
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { touch.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    if focus.has-focus || root.show-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
}

/// Search field (Fluent "TextBox" metrics and focus line, Spectrum "Search
/// field" anatomy): magnifier left, clear button once there is text, Escape
/// clears, Enter is not needed because filtering happens as you type.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    /// Accessible name; defaults to the placeholder.
    in property <string> label: root.placeholder;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback edited(string);
    height: Theme.control-height;
    min-width: 120px;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: !root.enabled ? Theme.control-disabled : (input.has-focus ? Theme.surface-window : Theme.surface-card);
    animate background, border-color { duration: Theme.motion-fast; }
    forward-focus: input;

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-xs;
        spacing: Theme.space-s;
        Icon {
            source: Icons.search;
            size: Theme.icon-s;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            clip: true;
            horizontal-stretch: 1;
            if root.text == "" : Text {
                text: root.placeholder;
                color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                font-size: Theme.font-body;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            input := TextInput {
                enabled: root.enabled;
                text <=> root.text;
                color: root.enabled ? Theme.text : Theme.text-disabled;
                font-size: Theme.font-body;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.on-accent;
                width: parent.width;
                height: parent.height;
                accessible-placeholder-text: root.placeholder;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if event.text == Key.Escape && self.text != "" {
                        self.text = "";
                        root.edited("");
                        return accept;
                    }
                    return reject;
                }
            }
        }
        if root.text != "" && root.enabled : Rectangle {
            width: Theme.control-height-s;
            height: Theme.control-height-s;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-s;
            background: clear-touch.has-hover ? Theme.control-hover : transparent;
            accessible-role: button;
            accessible-label: @tr("Clear search");
            accessible-action-default => { clear-touch.clicked(); }
            clear-touch := TouchArea {
                clicked => { root.text = ""; root.edited(""); input.focus(); }
            }
            Icon {
                source: Icons.dismiss;
                size: Theme.icon-s;
                color: Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            Tooltip { text: @markdown("\{@tr("Clear search")}"); }
        }
    }
    // Focus line along the bottom edge (Fluent TextBox).
    if input.has-focus : Rectangle {
        x: root.border-radius;
        y: parent.height - self.height;
        width: parent.width - 2 * root.border-radius;
        height: 2px;
        background: Theme.accent;
    }
}

/// A labelled set of mutually exclusive options (Fluent "RadioButtons",
/// Spectrum "ActionGroup" single-select): one tab stop, arrow keys move the
/// selection, the group carries the accessible name. Use for 2–5 static
/// options instead of a ComboBox.
export component ChoiceGroup inherits VerticalLayout {
    in property <[string]> options;
    /// Spoken names per option; falls back to `options`.
    in property <[string]> accessible-options: [];
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <int> selected-index;
    callback changed(int);
    spacing: 0;
    accessible-role: groupbox;
    accessible-label: root.label;
    forward-focus: group-focus;
    function select(i: int) {
        if i >= 0 && i < root.options.length && i != root.selected-index {
            root.selected-index = i;
            root.changed(i);
        }
    }
    group-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.select(max(0, root.selected-index - 1)); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.select(min(root.options.length - 1, root.selected-index + 1)); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.options.length - 1); return accept; }
            return reject;
        }
        HorizontalLayout {
            spacing: Theme.space-xs;
            for option[i] in root.options : ChoiceButton {
                text: option;
                accessible-text: i < root.accessible-options.length ? root.accessible-options[i] : "";
                horizontal-stretch: 1;
                enabled: root.enabled;
                focusable: false;
                selected: i == root.selected-index;
                show-focus: group-focus.has-focus && i == root.selected-index;
                clicked => { root.select(i); group-focus.focus(); }
            }
        }
    }
}

/// Text button at the standard control height; std `Button` alone stretches
/// to its layout cell, which breaks alignment in bars (Fluent "Button").
export component ActionButton inherits Button {
    height: Theme.control-height;
    // Fluent asks 120 px for command buttons; panes as narrow as 280 px
    // cannot afford it, so 96 here and 120 in DialogButtons (DESIGN.md §4).
    min-width: 96px;
    colorize-icon: true;
}

/// Toolbar row: fixed bar height, controls exactly `control-height` tall and
/// vertically centred (Fluent "CommandBar": 48 px bar, 32 px controls).
export component Bar inherits Rectangle {
    in property <length> bar-height: Theme.toolbar-height;
    in property <length> side-padding: Theme.space-l;
    height: root.bar-height;
    HorizontalLayout {
        padding-left: root.side-padding;
        padding-right: root.side-padding;
        padding-top: (root.bar-height - Theme.control-height) / 2;
        padding-bottom: (root.bar-height - Theme.control-height) / 2;
        spacing: Theme.space-s;
        @children
    }
}

/// Section heading inside panes and inspectors (Spectrum "Field label").
export component SectionLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-secondary;
    font-weight: Theme.weight-semibold;
    vertical-alignment: center;
    overflow: elide;
}

/// Pane / dialog-section heading (16 semibold).
export component Title inherits Text {
    color: Theme.text;
    font-size: Theme.font-title;
    font-weight: Theme.weight-semibold;
    vertical-alignment: center;
    overflow: elide;
}

/// Secondary running text (12 regular): status lines, hints.
export component SecondaryText inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-secondary;
    vertical-alignment: center;
    overflow: elide;
}

/// Inspector / form section: label above, controls below, 8 px apart
/// (Spectrum "Form", vertical labels). Sections are 24 px apart.
export component Section inherits VerticalLayout {
    in property <string> title;
    spacing: Theme.space-s;
    alignment: start;
    SectionLabel { text: root.title; }
    @children
}

/// Small secondary text (timecodes, counts, hints).
export component Caption inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    vertical-alignment: center;
    overflow: elide;
}

/// Body text in the style's foreground colour.
export component BodyText inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

/// 1 px horizontal separator between two bars (stretches in a layout).
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// 1 px vertical separator between two panes (stretches in a layout).
export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

/// Small status badge over a thumbnail or clip (Spectrum "Badge", icon-only).
export component Badge inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: Theme.text;
    /// Spoken / tooltip name of what the badge means.
    in property <string> label;
    /// Short text instead of an icon ("HDR"); Spectrum label badge.
    in property <string> text;
    width: root.text != "" ? badge-text.preferred-width + 2 * Theme.space-s : 22px;
    height: root.text != "" ? Theme.control-height-s : 22px;
    border-radius: Theme.radius-s;
    background: Theme.badge-backdrop;
    accessible-role: image;
    accessible-label: root.label != "" ? root.label : root.text;
    if root.text == "" : Icon {
        source: root.icon;
        size: Theme.icon-s;
        color: root.tint;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    badge-text := Text {
        visible: root.text != "";
        text: root.text;
        color: root.tint;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    if root.label != "" : Tooltip { text: @markdown("\{root.label}"); }
}

/// Empty state: what this area is, why it is empty, one next step
/// (Primer "Empty states", Spectrum "Illustrated message").
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    in property <string> secondary-text;
    callback action();
    callback secondary();
    alignment: center;
    spacing: Theme.space-m;
    padding: Theme.space-xl;
    max-width: 480px;
    HorizontalLayout {
        alignment: center;
        Icon { source: root.icon; size: Theme.icon-xl; color: Theme.text-secondary; }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.description != "" : Text {
        text: root.description;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action-text != "" || root.secondary-text != "" : HorizontalLayout {
        alignment: center;
        spacing: Theme.space-s;
        if root.action-text != "" : ActionButton {
            text: root.action-text;
            primary: true;
            enabled: root.action-enabled;
            clicked => { root.action(); }
        }
        if root.secondary-text != "" : ActionButton {
            text: root.secondary-text;
            clicked => { root.secondary(); }
        }
    }
}

/// Modal surface with scrim, title and platform-ordered buttons. The caller
/// places its content as children; buttons are rendered by the caller inside
/// `DialogButtons` so their order follows the platform (Windows: primary
/// first, macOS: primary last).
export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 480px;
    /// 0 = size to content.
    in property <length> dialog-height: 0;
    callback dismissed();
    /// Enter: activate the dialog's default action (Fluent DefaultButton).
    callback accepted();
    background: Theme.scrim;
    // Swallow clicks on the scrim (do not close: accidental loss of input).
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(); return accept; }
            if event.text == Key.Return { root.accepted(); return accept; }
            return reject;
        }
        Rectangle {
            width: root.dialog-width;
            height: root.dialog-height > 0 ? root.dialog-height : content.preferred-height;
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-pane;
            clip: true;
            TouchArea { }
            content := VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-l;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-dialog;
                    font-weight: Theme.weight-semibold;
                }
                @children
            }
        }
    }
}

/// Button row for dialogs: primary on the left on Windows, on the right on
/// macOS (Fluent "Dialog", Apple HIG "Alerts").
export component DialogButtons inherits HorizontalLayout {
    in property <bool> macos;
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    in property <bool> primary-visible: true;
    in property <string> secondary-text;
    callback primary();
    callback secondary();
    spacing: Theme.space-s;
    alignment: end;
    if root.macos && root.secondary-text != "" : ActionButton { text: root.secondary-text; min-width: 120px; clicked => { root.secondary(); } }
    if root.primary-visible : ActionButton { text: root.primary-text; min-width: 120px; primary: true; enabled: root.primary-enabled; clicked => { root.primary(); } }
    if !root.macos && root.secondary-text != "" : ActionButton { text: root.secondary-text; min-width: 120px; clicked => { root.secondary(); } }
}
