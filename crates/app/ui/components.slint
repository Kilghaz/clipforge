// Shared ClipForge components (docs/ux/DESIGN.md §4). Each one copies the
// states and behaviour of its Fluent / Spectrum reference and only uses
// `Theme` tokens and `Palette` colours.
import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

/// Single-colour icon, recoloured to the given brush (Fluent iconography).
export component Icon inherits Image {
    in property <length> size: Theme.icon-m;
    in property <brush> color: Theme.text;
    width: root.size;
    height: root.size;
    colorize: root.color;
    image-fit: contain;
}

/// Icon-only button, built directly (the std `Button` reserves room for a
/// text label and its 12 px padding, so a 20 px icon never centres in 32 px).
/// States and metrics follow Fluent "Button": 32 × 32, radius 4, 1 px border,
/// hover / pressed / disabled / checked, visible focus ring, tooltip and
/// accessible label always present.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> checkable;
    /// Borderless until hovered (Fluent command-bar buttons).
    in property <bool> quiet;
    /// False inside a group that is a single tab stop.
    in property <bool> focusable: true;
    /// Draw the focus ring on the group's behalf.
    in property <bool> show-focus;
    in-out property <bool> checked;
    callback clicked;
    property <bool> accent: root.primary || root.checked;
    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: root.accent || root.quiet ? transparent : Theme.border;
    background: root.accent ? Theme.accent : (root.quiet ? transparent : Theme.surface-card);
    animate background { duration: Theme.motion-fast; }
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { touch.clicked(); }
    forward-focus: focus;

    states [
        disabled when !root.enabled : {
            // Quiet buttons stay borderless when disabled; only the glyph dims.
            root.background: root.accent ? Theme.accent-disabled : (root.quiet ? transparent : Theme.control-disabled);
            root.border-color: root.accent || root.quiet ? transparent : Theme.border;
            glyph.color: root.accent ? Theme.on-accent-disabled : Theme.text-disabled;
        }
        pressed when touch.pressed : {
            root.background: root.accent ? Theme.accent-pressed : Theme.control-pressed;
            glyph.color: root.accent ? Theme.on-accent : Theme.text-secondary;
        }
        hover when touch.has-hover : {
            root.background: root.accent ? Theme.accent-hover : Theme.control-hover;
        }
    ]

    focus := FocusScope {
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { touch.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if root.checkable { root.checked = !root.checked; }
            root.clicked();
        }
    }
    glyph := Icon {
        source: root.icon;
        size: Theme.icon-m;
        color: root.accent ? Theme.on-accent : Theme.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    // Focus ring outside the control (Fluent "FocusBorder").
    if focus.has-focus || root.show-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

/// One option of a small set (duration presets): text version of
/// `IconButton`. The std `Button` checked state differs per style and is
/// unreadable in cupertino; this one uses our tokens (Spectrum "Action group").
export component ChoiceButton inherits Rectangle {
    in property <string> text;
    /// Spoken name when `text` is an abbreviation ("4 s" → "4 seconds").
    in property <string> accessible-text;
    in property <bool> enabled: true;
    in property <bool> selected;
    /// False inside a ChoiceGroup: the group is the single tab stop.
    in property <bool> focusable: true;
    /// Draw the focus ring on the group's behalf.
    in property <bool> show-focus;
    /// Tighter side padding, for four options in a narrow inspector.
    in property <bool> compact;
    callback clicked;
    height: Theme.control-height;
    min-width: max(40px, label.preferred-width + 2 * (root.compact ? Theme.space-s : Theme.space-m));
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: root.selected ? transparent : Theme.border;
    background: root.selected ? Theme.accent : Theme.surface-card;
    animate background { duration: Theme.motion-fast; }
    accessible-role: button;
    accessible-label: root.accessible-text != "" ? root.accessible-text : root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { touch.clicked(); }
    forward-focus: focus;

    states [
        disabled when !root.enabled : {
            root.background: root.selected ? Theme.accent-disabled : Theme.control-disabled;
            label.color: root.selected ? Theme.on-accent-disabled : Theme.text-disabled;
        }
        pressed when touch.pressed : {
            root.background: root.selected ? Theme.accent-pressed : Theme.control-pressed;
        }
        hover when touch.has-hover : {
            root.background: root.selected ? Theme.accent-hover : Theme.control-hover;
        }
    ]

    focus := FocusScope {
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { touch.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    if focus.has-focus || root.show-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
}

/// Search field (Fluent "TextBox" metrics and focus line, Spectrum "Search
/// field" anatomy): magnifier left, clear button once there is text, Escape
/// clears, Enter is not needed because filtering happens as you type.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    /// Accessible name; defaults to the placeholder.
    in property <string> label: root.placeholder;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback edited(string);
    height: Theme.control-height;
    min-width: 120px;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: !root.enabled ? Theme.control-disabled : (input.has-focus ? Theme.surface-window : Theme.surface-card);
    animate background, border-color { duration: Theme.motion-fast; }
    forward-focus: input;

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-xs;
        spacing: Theme.space-s;
        Icon {
            source: Icons.search;
            size: Theme.icon-s;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            clip: true;
            horizontal-stretch: 1;
            if root.text == "" : Text {
                text: root.placeholder;
                color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                font-size: Theme.font-body;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            input := TextInput {
                enabled: root.enabled;
                text <=> root.text;
                color: root.enabled ? Theme.text : Theme.text-disabled;
                font-size: Theme.font-body;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.on-accent;
                width: parent.width;
                height: parent.height;
                accessible-placeholder-text: root.placeholder;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if event.text == Key.Escape && self.text != "" {
                        self.text = "";
                        root.edited("");
                        return accept;
                    }
                    return reject;
                }
            }
        }
        if root.text != "" && root.enabled : Rectangle {
            width: Theme.control-height-s;
            height: Theme.control-height-s;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-s;
            background: clear-touch.has-hover ? Theme.control-hover : transparent;
            accessible-role: button;
            accessible-label: @tr("Clear search");
            accessible-action-default => { clear-touch.clicked(); }
            clear-touch := TouchArea {
                clicked => { root.text = ""; root.edited(""); input.focus(); }
            }
            Icon {
                source: Icons.dismiss;
                size: Theme.icon-s;
                color: Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            Tooltip { text: @markdown("\{@tr("Clear search")}"); }
        }
    }
    // Focus line along the bottom edge (Fluent TextBox).
    if input.has-focus : Rectangle {
        x: root.border-radius;
        y: parent.height - self.height;
        width: parent.width - 2 * root.border-radius;
        height: 2px;
        background: Theme.accent;
    }
}

/// A labelled set of mutually exclusive options (Fluent "RadioButtons",
/// Spectrum "ActionGroup" single-select): one tab stop, arrow keys move the
/// selection, the group carries the accessible name. Use for 2–5 static
/// options instead of a ComboBox.
export component ChoiceGroup inherits VerticalLayout {
    in property <[string]> options;
    /// Spoken names per option; falls back to `options`.
    in property <[string]> accessible-options: [];
    in property <string> label;
    in property <bool> enabled: true;
    /// Tighter buttons (see `ChoiceButton.compact`).
    in property <bool> compact;
    in-out property <int> selected-index;
    callback changed(int);
    spacing: 0;
    accessible-role: groupbox;
    accessible-label: root.label;
    forward-focus: group-focus;
    function select(i: int) {
        if i >= 0 && i < root.options.length && i != root.selected-index {
            root.selected-index = i;
            root.changed(i);
        }
    }
    group-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.select(max(0, root.selected-index - 1)); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.select(min(root.options.length - 1, root.selected-index + 1)); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.options.length - 1); return accept; }
            return reject;
        }
        HorizontalLayout {
            spacing: Theme.space-xs;
            for option[i] in root.options : ChoiceButton {
                text: option;
                accessible-text: i < root.accessible-options.length ? root.accessible-options[i] : "";
                horizontal-stretch: 1;
                enabled: root.enabled;
                focusable: false;
                compact: root.compact;
                selected: i == root.selected-index;
                show-focus: group-focus.has-focus && i == root.selected-index;
                clicked => { root.select(i); group-focus.focus(); }
            }
        }
    }
}

/// Text button at the standard control height; std `Button` alone stretches
/// to its layout cell, which breaks alignment in bars (Fluent "Button").
export component ActionButton inherits Button {
    height: Theme.control-height;
    // Fluent asks 120 px for command buttons; panes as narrow as 280 px
    // cannot afford it, so 96 here and 120 in DialogButtons (DESIGN.md §4).
    min-width: 96px;
    colorize-icon: true;
}

/// Toolbar row: fixed bar height, controls exactly `control-height` tall and
/// vertically centred (Fluent "CommandBar": 48 px bar, 32 px controls).
export component Bar inherits Rectangle {
    in property <length> bar-height: Theme.toolbar-height;
    in property <length> side-padding: Theme.space-l;
    height: root.bar-height;
    HorizontalLayout {
        padding-left: root.side-padding;
        padding-right: root.side-padding;
        padding-top: (root.bar-height - Theme.control-height) / 2;
        padding-bottom: (root.bar-height - Theme.control-height) / 2;
        spacing: Theme.space-s;
        @children
    }
}

/// Section heading inside panes and inspectors (Spectrum "Field label").
export component SectionLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-secondary;
    font-weight: Theme.weight-semibold;
    vertical-alignment: center;
    overflow: elide;
}

/// Pane / dialog-section heading (16 semibold).
export component Title inherits Text {
    color: Theme.text;
    font-size: Theme.font-title;
    font-weight: Theme.weight-semibold;
    vertical-alignment: center;
    overflow: elide;
}

/// Secondary running text (12 regular): status lines, hints.
export component SecondaryText inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-secondary;
    vertical-alignment: center;
    overflow: elide;
}

/// Inspector / form section: label above, controls below, 8 px apart
/// (Spectrum "Form", vertical labels). Sections are 24 px apart.
export component Section inherits VerticalLayout {
    in property <string> title;
    spacing: Theme.space-s;
    alignment: start;
    SectionLabel { text: root.title; }
    @children
}

/// Small secondary text (timecodes, counts, hints).
export component Caption inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    vertical-alignment: center;
    overflow: elide;
}

/// Body text in the style's foreground colour.
export component BodyText inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

/// 1 px horizontal separator between two bars (stretches in a layout).
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// 1 px vertical separator between two panes (stretches in a layout).
export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

/// Small status badge over a thumbnail or clip (Spectrum "Badge", icon-only).
export component Badge inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: Theme.text;
    /// Spoken / tooltip name of what the badge means.
    in property <string> label;
    /// Short text instead of an icon ("HDR"); Spectrum label badge.
    in property <string> text;
    width: root.text != "" ? badge-text.preferred-width + 2 * Theme.space-s : 22px;
    height: root.text != "" ? Theme.control-height-s : 22px;
    border-radius: Theme.radius-s;
    background: Theme.badge-backdrop;
    accessible-role: image;
    accessible-label: root.label != "" ? root.label : root.text;
    if root.text == "" : Icon {
        source: root.icon;
        size: Theme.icon-s;
        color: root.tint;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    badge-text := Text {
        visible: root.text != "";
        text: root.text;
        color: root.tint;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    if root.label != "" : Tooltip { text: @markdown("\{root.label}"); }
}

/// Empty state: what this area is, why it is empty, one next step
/// (Primer "Empty states", Spectrum "Illustrated message").
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    in property <string> secondary-text;
    callback action();
    callback secondary();
    alignment: center;
    spacing: Theme.space-m;
    padding: Theme.space-xl;
    max-width: 480px;
    HorizontalLayout {
        alignment: center;
        Icon { source: root.icon; size: Theme.icon-xl; color: Theme.text-secondary; }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.description != "" : Text {
        text: root.description;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action-text != "" || root.secondary-text != "" : HorizontalLayout {
        alignment: center;
        spacing: Theme.space-s;
        if root.action-text != "" : ActionButton {
            text: root.action-text;
            primary: true;
            enabled: root.action-enabled;
            clicked => { root.action(); }
        }
        if root.secondary-text != "" : ActionButton {
            text: root.secondary-text;
            clicked => { root.secondary(); }
        }
    }
}

/// Modal surface with scrim, title and platform-ordered buttons. The caller
/// places its content as children; buttons are rendered by the caller inside
/// `DialogButtons` so their order follows the platform (Windows: primary
/// first, macOS: primary last).
export component DialogButtons inherits HorizontalLayout {
    in property <bool> macos;
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    in property <bool> primary-visible: true;
    in property <string> secondary-text;
    callback primary();
    callback secondary();
    spacing: Theme.space-s;
    alignment: end;
    if root.macos && root.secondary-text != "" : ActionButton { text: root.secondary-text; min-width: 120px; clicked => { root.secondary(); } }
    if root.primary-visible : ActionButton { text: root.primary-text; min-width: 120px; primary: true; enabled: root.primary-enabled; clicked => { root.primary(); } }
    if !root.macos && root.secondary-text != "" : ActionButton { text: root.secondary-text; min-width: 120px; clicked => { root.secondary(); } }
}

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 480px;
    /// 0 = size to content.
    in property <length> dialog-height: 0;
    /// Button row, fixed at the bottom while the content scrolls (Fluent).
    in property <bool> macos;
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    in property <bool> primary-visible: true;
    in property <string> secondary-text;
    callback primary();
    callback secondary();
    callback dismissed();
    /// Enter: activate the dialog's default action (Fluent DefaultButton).
    callback accepted();
    background: Theme.scrim;
    // Swallow clicks on the scrim (do not close: accidental loss of input).
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(); return accept; }
            if event.text == Key.Return { root.accepted(); return accept; }
            return reject;
        }
        card := Rectangle {
            // Never taller than the window: the content scrolls, the title
            // and buttons stay (900 × 560 minimum window).
            property <length> wanted: root.dialog-height > 0 ? root.dialog-height : frame.preferred-height;
            property <bool> scrolls: body.preferred-height > flick.height + 2px;
            width: root.dialog-width;
            height: min(self.wanted, root.height - 2 * Theme.space-l);
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-pane;
            clip: true;
            TouchArea { }
            frame := VerticalLayout {
                padding: Theme.space-xl;
                // The body keeps a scrollbar gutter on the right instead.
                padding-right: Theme.space-xl - Theme.space-m;
                spacing: Theme.space-l;
                title := Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-dialog;
                    font-weight: Theme.weight-semibold;
                }
                // std ScrollView: a visible scrollbar tells the content goes on.
                flick := ScrollView {
                    vertical-stretch: 1;
                    // Size to the content; the frame caps it at the window.
                    preferred-height: body.preferred-height;
                    horizontal-scrollbar-policy: always-off;
                    // Sub-pixel overflow would otherwise show a bar on content that fits.
                    vertical-scrollbar-policy: card.scrolls ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
                    body := VerticalLayout {
                        // Gutter for the scrollbar so it never covers controls.
                        padding-right: Theme.space-m;
                        spacing: Theme.space-l;
                        alignment: start;
                        @children
                    }
                }
                footer := DialogButtons {
                    padding-right: Theme.space-m;
                    macos: root.macos;
                    primary-text: root.primary-text;
                    primary-enabled: root.primary-enabled;
                    primary-visible: root.primary-visible && root.primary-text != "";
                    secondary-text: root.secondary-text;
                    primary => { root.primary(); }
                    secondary => { root.secondary(); }
                }
            }
            // More content below: a hairline above the buttons.
            if card.scrolls && -flick.content-y + flick.height < body.preferred-height - 1px : Rectangle {
                x: 0;
                y: flick.y + flick.height + Theme.space-l / 2;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
        }
    }
}


/// Single choice from a small fixed palette (Spectrum "ColorSwatchPicker").
/// One tab stop; arrow keys move the selection; each swatch names its colour
/// in the tooltip and to screen readers.
export component SwatchGroup inherits HorizontalLayout {
    in property <[color]> colors;
    in property <[string]> names;
    in property <string> label;
    in property <bool> enabled: true;
    /// Smaller cells and gaps, for eight colours in a narrow inspector.
    in property <bool> compact;
    in-out property <int> selected-index;
    callback changed(int);
    spacing: root.compact ? Theme.space-xs : Theme.space-s;
    alignment: start;
    accessible-role: groupbox;
    accessible-label: root.label;
    forward-focus: group-focus;
    function select(i: int) {
        if i >= 0 && i < root.colors.length && i != root.selected-index {
            root.selected-index = i;
            root.changed(i);
        }
    }
    group-focus := FocusScope {
        enabled: root.enabled;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.select(max(0, root.selected-index - 1)); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.select(min(root.colors.length - 1, root.selected-index + 1)); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.colors.length - 1); return accept; }
            return reject;
        }
    }
    for c[i] in root.colors : Rectangle {
        width: root.compact ? Theme.control-height-s + Theme.space-xs : Theme.control-height;
        height: self.width;
        property <bool> selected: i == root.selected-index;
        accessible-role: button;
        accessible-label: i < root.names.length ? root.names[i] : "";
        accessible-checkable: true;
        accessible-checked: self.selected;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.select(i); }
        // Selected: accent ring with a gap, so dark and light swatches both show it.
        Rectangle {
            border-radius: Theme.radius-s + 2px;
            border-width: 2px;
            border-color: parent.selected ? (group-focus.has-focus ? Theme.focus-ring : Theme.accent) : transparent;
        }
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: Theme.radius-s;
            background: c;
            border-width: 1px;
            // A light edge so dark swatches stand out from the dark pane.
            border-color: touch.has-hover && root.enabled ? Theme.text : Theme.text-disabled;
            opacity: root.enabled ? 1 : 0.4;
        }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.select(i); group-focus.focus(); }
        }
        Tooltip { text: @markdown("\{i < root.names.length ? root.names[i] : ""}"); }
    }
}

/// One song of the music playlist (Fluent list view item with item
/// actions): name, length, move up / down and remove.
export component SongRow inherits Rectangle {
    in property <string> title;
    in property <string> duration-text;
    in property <bool> first;
    in property <bool> last;
    callback move-up;
    callback move-down;
    callback remove;
    height: Theme.bar-height;
    accessible-role: list-item;
    accessible-label: root.title + ", " + root.duration-text;
    HorizontalLayout {
        spacing: Theme.space-xs;
        Icon { source: Icons.music-note; size: Theme.icon-s; color: Theme.audio; y: (parent.height - self.height) / 2; }
        Rectangle { width: Theme.space-xs; }
        // Name above, length below: the name gets the whole remaining width.
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: center;
            Text { text: root.title; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
            Text { text: root.duration-text; color: Theme.text-secondary; font-size: Theme.font-caption; }
        }
        IconButton { icon: Icons.arrow-up; tooltip: @tr("Move up"); quiet: true; enabled: !root.first; clicked => { root.move-up(); } }
        IconButton { icon: Icons.arrow-down; tooltip: @tr("Move down"); quiet: true; enabled: !root.last; clicked => { root.move-down(); } }
        IconButton { icon: Icons.dismiss; tooltip: @tr("Remove song"); quiet: true; clicked => { root.remove(); } }
    }
}

/// Single choice among icons (Spectrum "ActionGroup", single selection):
/// one tab stop, arrow keys move the selection, every icon has a tooltip and
/// an accessible name. Text alignment.
export component IconChoiceGroup inherits HorizontalLayout {
    in property <[image]> icons;
    in property <[string]> labels;
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <int> selected-index;
    callback changed(int);
    spacing: Theme.space-xs;
    alignment: start;
    accessible-role: groupbox;
    accessible-label: root.label;
    forward-focus: group-focus;
    function select(i: int) {
        if i >= 0 && i < root.icons.length && i != root.selected-index {
            root.selected-index = i;
            root.changed(i);
        }
    }
    group-focus := FocusScope {
        enabled: root.enabled;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.select(max(0, root.selected-index - 1)); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.select(min(root.icons.length - 1, root.selected-index + 1)); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.icons.length - 1); return accept; }
            return reject;
        }
    }
    for icon[i] in root.icons : IconButton {
        icon: icon;
        tooltip: i < root.labels.length ? root.labels[i] : "";
        enabled: root.enabled;
        focusable: false;
        checked: i == root.selected-index;
        show-focus: group-focus.has-focus && i == root.selected-index;
        clicked => { root.select(i); group-focus.focus(); }
    }
}

/// Font chooser with type-to-filter (Spectrum "ComboBox"): shows the current
/// family; typing filters the list (the app does the matching), ↑/↓ move
/// through it, Enter picks, Escape restores. Each entry is drawn in its own
/// font so the list is a preview.
///
/// The list opens *inline* below the field instead of in a popup: a popup
/// takes the keyboard away from the field, and closing it hands focus back,
/// which reopened it. Inline, the field keeps the focus the whole time.
export component FontPicker inherits Rectangle {
    /// The chosen family.
    in property <string> value;
    /// Families matching the search, best first (set by the app).
    in property <[string]> matches;
    in property <string> label;
    in property <bool> enabled: true;
    callback search(string);
    callback picked(string);
    in-out property <bool> expanded;
    property <int> highlight: 0;
    property <length> row-height: Theme.control-height;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-expanded: root.expanded;
    forward-focus: input;
    function open() {
        if !root.expanded {
            root.highlight = 0;
            root.expanded = true;
        }
    }
    function close() {
        root.expanded = false;
        input.text = root.value;
    }
    function pick(i: int) {
        if i >= 0 && i < root.matches.length {
            input.text = root.matches[i];
            root.picked(root.matches[i]);
        }
        root.expanded = false;
    }
    VerticalLayout {
    spacing: Theme.space-xs;
    field := Rectangle {
        height: Theme.control-height;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface-card;
        HorizontalLayout {
            padding-left: Theme.space-s;
            padding-right: Theme.space-xs;
            spacing: Theme.space-xs;
            input := TextInput {
                text: root.value;
                enabled: root.enabled;
                color: root.enabled ? Theme.text : Theme.text-disabled;
                font-size: Theme.font-body;
                vertical-alignment: center;
                single-line: true;
                horizontal-stretch: 1;
                accessible-label: root.label;
                // Leaving the field closes the list and shows the value again.
                changed has-focus => {
                    if !self.has-focus { root.close(); }
                }
                edited => {
                    root.search(self.text);
                    root.open();
                    root.highlight = 0;
                }
                key-pressed(event) => {
                    if event.text == Key.DownArrow {
                        if !root.expanded { root.search(""); root.open(); } else { root.highlight = min(root.matches.length - 1, root.highlight + 1); }
                        return accept;
                    }
                    if event.text == Key.UpArrow { root.highlight = max(0, root.highlight - 1); return accept; }
                    if event.text == Key.Return {
                        if root.expanded { root.pick(root.highlight); } else { root.search(""); root.open(); }
                        return accept;
                    }
                    if event.text == Key.Escape && root.expanded { root.close(); return accept; }
                    return reject;
                }
            }
            chevron := Rectangle {
                width: Theme.icon-m;
                Icon {
                    source: root.expanded ? Icons.chevron-up : Icons.chevron-down;
                    size: Theme.icon-s;
                    color: Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        // A click anywhere on the field opens (or closes) the list; the text
        // field underneath still gets the focus for typing.
        TouchArea {
            enabled: root.enabled;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    input.focus();
                    if root.expanded { root.close(); } else { input.select-all(); root.search(""); root.open(); }
                }
            }
        }
    }
    if root.expanded : Rectangle {
        height: min(8, max(1, root.matches.length)) * root.row-height + 2 * Theme.space-xs;
        background: Theme.surface-card;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        if root.matches.length == 0 : Text {
            x: Theme.space-s;
            y: Theme.space-xs;
            height: root.row-height;
            text: @tr("No fonts match");
            color: Theme.text-secondary;
            font-size: Theme.font-secondary;
            vertical-alignment: center;
        }
        // Rows have fixed geometry, so none of them measures its text, and
        // rows scrolled out of view are not drawn (their fonts not loaded).
        list := Flickable {
            y: Theme.space-xs;
            height: parent.height - 2 * Theme.space-xs;
            content-height: root.matches.length * root.row-height;
            // Keep the highlighted row in view.
            content-y: min(0px, self.height - (root.highlight + 1) * root.row-height);
            for name[i] in root.matches : Rectangle {
                y: i * root.row-height;
                height: root.row-height;
                width: parent.width;
                background: i == root.highlight ? Theme.selection-tint : (row-touch.has-hover ? Theme.hover-tint : transparent);
                accessible-role: list-item;
                accessible-label: name;
                accessible-item-selected: i == root.highlight;
                Text {
                    x: Theme.space-s;
                    width: parent.width - 2 * Theme.space-s;
                    height: parent.height;
                    text: name;
                    font-family: name;
                    font-size: Theme.font-body;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Pick on press: a click could move the focus off the field
                // first, which closes the list before the release arrives.
                row-touch := TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            root.pick(i);
                            input.focus();
                        }
                    }
                }
            }
        }
    }
    }
}

/// Progressive disclosure trigger (Primer): chevron plus label, toggles a
/// section below. Down when collapsed, up when expanded.
export component Disclosure inherits Rectangle {
    in property <string> text;
    in-out property <bool> expanded;
    /// Draw the focus ring without focus (gallery).
    in property <bool> show-focus;
    callback toggled(bool);
    height: Theme.control-height;
    border-radius: Theme.radius-s;
    background: touch.has-hover ? Theme.control-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.toggle(); }
    accessible-action-expand => { root.toggle(); }
    forward-focus: focus;
    function toggle() {
        root.expanded = !root.expanded;
        root.toggled(root.expanded);
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggle(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { clicked => { root.toggle(); focus.focus(); } }
    HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.expanded ? Icons.chevron-up : Icons.chevron-down;
                size: Theme.icon-s;
                color: Theme.text-secondary;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
    if focus.has-focus || root.show-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
}

/// Toolbar stand-in for the Export button while an export runs in the
/// background or finished unseen: progress (percent and a thin bar), or
/// the result icon. Clicking reopens the export dialog.
export component ExportStatusButton inherits Rectangle {
    /// 1 running, 2 done, 3 failed, 4 done with a warning.
    in property <int> status: 1;
    in property <float> progress;
    in property <string> text;
    in property <string> tooltip;
    /// Draw the focus ring without focus (gallery).
    in property <bool> show-focus;
    callback clicked;
    height: Theme.control-height;
    min-width: 96px;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : Theme.surface-card;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-value: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;
        alignment: center;
        if root.status != 1 : VerticalLayout {
            alignment: center;
            Icon {
                source: root.status == 2 ? Icons.checkmark-circle : root.status == 4 ? Icons.warning : Icons.error-circle;
                color: root.status == 2 ? Theme.success : root.status == 4 ? Theme.warning : Theme.danger;
                size: Theme.icon-m;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    // Thin progress bar along the bottom edge while running.
    if root.status == 1 : Rectangle {
        x: Theme.space-xs;
        y: parent.height - 5px;
        width: parent.width - 2 * Theme.space-xs;
        height: 2px;
        border-radius: self.height / 2;
        background: Theme.border;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.progress, 0, 1);
            height: parent.height;
            border-radius: self.height / 2;
            background: Theme.accent;
        }
    }
    if focus.has-focus || root.show-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-s + 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}
