import { ListView, LineEdit, ComboBox, Button, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { Shell } from "shell.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton, SearchField, Bar, SectionLabel, Caption, BodyText, Divider, Badge, EmptyState } from "components.slint";

export struct MediaCell {
    index: int,
    id: string,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    // 0 photo, 1 video, 2 audio, 3 unknown
    kind: int,
    cloud: bool,
    failed: bool,
    pending: bool,
    selected: bool,
}

export struct GridRow {
    cells: [MediaCell],
}

export struct InspectorInfo {
    visible: bool,
    title: string,
    // 0 photo, 1 video, 2 audio, 3 unknown
    kind: int,
    dimensions: string,
    duration: string,
    captured: string,
    codec: string,
    size: string,
    path: string,
    // 0 pending, 1 ready, 2 failed, 3 not downloaded
    status-kind: int,
    error: string,
    hdr: bool,
}

/// All library screen state, owned and driven by Rust.
export global LibraryState {
    in-out property <[GridRow]> rows;
    in-out property <int> total-count;
    // 0 idle, 1 scanning, 2 importing, 3 finished
    in-out property <int> status-kind;
    in-out property <int> import-done;
    in-out property <int> import-total;
    in-out property <int> import-added;
    in-out property <int> import-existing;
    in-out property <InspectorInfo> inspector;
    in-out property <image> inspector-image;
    in-out property <bool> inspector-has-image;
    in-out property <string> search-text;
    in-out property <int> filter-index;
    in-out property <int> sort-index;
    in-out property <bool> descending: true;
    /// True while files are dragged over the window.
    in-out property <bool> drop-hover;
    /// Marquee rectangle in grid coordinates (px); visible while selecting.
    in-out property <bool> marquee-visible;
    in-out property <float> marquee-x;
    in-out property <float> marquee-y;
    in-out property <float> marquee-w;
    in-out property <float> marquee-h;
    in-out property <int> selected-count;
    /// Current width of the grid area; Rust polls it to lay out columns.
    in-out property <length> grid-width;

    callback add-files();
    callback add-folder();
    callback search-changed(string);
    callback filter-changed(int);
    callback sort-changed(int);
    callback direction-toggled();
    /// Press on a cell with modifiers (shift, toggle).
    callback cell-pressed(int, bool, bool);
    /// Pointer moved while a cell is pressed; window coordinates in px.
    callback cell-drag-moved(int, float, float);
    /// Pointer released after a cell press; window coordinates in px.
    callback cell-released(int, float, float);
    /// Marquee (rubber band) in grid coordinates: start/move/end.
    callback marquee-start(float, float, bool);
    callback marquee-move(float, float);
    callback marquee-end();
    callback cell-shown(int);
    callback grid-width-changed(length);
    callback remove-selected();
    callback reveal-selected();
    callback add-selected-to-timeline();
    callback add-all-to-timeline();
    callback cell-double-clicked(int);
}

/// Media type / status badge in the thumbnail corner.
export component KindBadge inherits Badge {
    in property <int> kind;
    in property <bool> cloud;
    in property <bool> failed;
    icon: root.failed ? Icons.error-circle : (root.cloud ? Icons.cloud : (root.kind == 1 ? Icons.video : Icons.music-note));
    tint: root.failed ? Theme.danger : (root.cloud ? Theme.text : (root.kind == 1 ? Theme.video : Theme.audio));
    label: root.failed ? @tr("Could not be read") : (root.cloud ? @tr("Not downloaded") : (root.kind == 1 ? @tr("Video") : @tr("Audio")));
}

/// Library grid cell: Spectrum "Card" (quiet) with Fluent grid selection.
/// Geometry (104 × 112, row 116, padding 12, spacing 8) is mirrored in
/// `library_view.rs`; change both together.
export component CellView inherits Rectangle {
    in property <MediaCell> cell;
    callback pressed(bool, bool);
    callback dragged(float, float);
    callback released(float, float);
    callback double-clicked();
    callback shown();
    width: 104px;
    height: 112px;
    border-radius: Theme.radius-m;
    background: root.cell.selected ? Theme.selection-tint : (touch.has-hover ? Theme.hover-tint : transparent);
    border-width: root.cell.selected ? 2px : 0px;
    border-color: Theme.selection;
    animate background { duration: Theme.motion-fast; }
    accessible-role: button;
    accessible-label: root.cell.title;

    init => { root.shown(); }
    touch := TouchArea {
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            // Move events carry no button, so only filter down/up on it.
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed(e.modifiers.shift, e.modifiers.control || e.modifiers.meta);
            } else if e.kind == PointerEventKind.move && self.pressed {
                root.dragged((root.absolute-position.x + self.mouse-x) / 1px, (root.absolute-position.y + self.mouse-y) / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.released((root.absolute-position.x + self.mouse-x) / 1px, (root.absolute-position.y + self.mouse-y) / 1px);
            }
        }
    }

    VerticalLayout {
        padding: Theme.space-xs;
        spacing: Theme.space-xs;
        Rectangle {
            height: 78px;
            border-radius: Theme.radius-s;
            clip: true;
            background: Theme.surface-card;
            if root.cell.has-image : Image {
                source: root.cell.image;
                image-fit: contain;
                width: parent.width;
                height: parent.height;
            }
            // Placeholder while the thumbnail loads or when none exists.
            if !root.cell.has-image : Icon {
                source: root.cell.kind == 2 ? Icons.music-note : (root.cell.kind == 1 ? Icons.video : Icons.image);
                size: 28px;
                color: root.cell.pending ? Theme.text-disabled : Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.cell.kind != 0 || root.cell.cloud || root.cell.failed : KindBadge {
                kind: root.cell.kind;
                cloud: root.cell.cloud;
                failed: root.cell.failed;
                x: parent.width - self.width - Theme.space-xs;
                y: Theme.space-xs;
            }
        }
        Text {
            text: root.cell.title;
            color: Theme.text;
            font-size: Theme.font-caption;
            overflow: elide;
            horizontal-alignment: center;
        }
        Text {
            text: root.cell.subtitle;
            color: Theme.text-secondary;
            font-size: Theme.font-caption;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Theme.space-s;
    visible: root.value != "";
    Caption { text: root.label; width: 80px; }
    Text { text: root.value; color: Theme.text; font-size: Theme.font-caption; overflow: elide; horizontal-stretch: 1; }
}

export component LibraryPage inherits Rectangle {
    property <[GridRow]> rows: LibraryState.rows;
    property <int> total-count: LibraryState.total-count;
    property <InspectorInfo> inspector: LibraryState.inspector;
    property <bool> details-open: false;

    background: Theme.surface-pane;

    VerticalLayout {
        // Header: title, count, add actions.
        Bar {
            side-padding: Theme.space-l;
                Text {
                    text: @tr("Library");
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                Caption { text: root.total-count == 1 ? @tr("1 item") : @tr("{} items", root.total-count); }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.document-add; tooltip: @tr("Add files…"); clicked => { LibraryState.add-files(); } }
                IconButton { icon: Icons.folder-add; tooltip: @tr("Add folder…"); clicked => { LibraryState.add-folder(); } }
        }
        // Search on its own row, then type filter, sort and direction: the
        // pane is 260-500 px wide, one row would clip the controls.
        Bar {
            bar-height: Theme.bar-height;
            side-padding: Theme.space-l;
                SearchField {
                    horizontal-stretch: 1;
                    placeholder: @tr("Search the library");
                    text <=> LibraryState.search-text;
                    edited(t) => { LibraryState.search-changed(t); }
                }
        }
        Bar {
            bar-height: Theme.bar-height + Theme.space-s;
            side-padding: Theme.space-l;
                ComboBox {
                    horizontal-stretch: 1;
                    min-width: 96px;
                    height: Theme.control-height;
                    model: [@tr("All"), @tr("Photos"), @tr("Videos"), @tr("Audio")];
                    current-index <=> LibraryState.filter-index;
                    selected => { LibraryState.filter-changed(self.current-index); }
                    accessible-label: @tr("Filter by type");
                }
                ComboBox {
                    horizontal-stretch: 1;
                    min-width: 96px;
                    height: Theme.control-height;
                    model: [@tr("Date"), @tr("Name"), @tr("Type"), @tr("Added")];
                    current-index <=> LibraryState.sort-index;
                    selected => { LibraryState.sort-changed(self.current-index); }
                    accessible-label: @tr("Sort by");
                }
                IconButton {
                    icon: LibraryState.descending ? Icons.arrow-sort-down : Icons.arrow-sort-up;
                    tooltip: LibraryState.descending ? @tr("Newest first. Click for oldest first") : @tr("Oldest first. Click for newest first");
                    clicked => { LibraryState.direction-toggled(); }
                }
        }
        Divider { }
        // Grid
        grid := Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-window;
            // `init` runs before Rust has wired its callbacks, so the width
            // is also published as a property that Rust reads itself.
            changed width => { LibraryState.grid-width = self.width; LibraryState.grid-width-changed(self.width); }
            init => { LibraryState.grid-width = self.width; }
            lv := ListView {
                for row[r] in root.rows : Rectangle {
                    height: 116px;
                    // Empty space in a row starts a marquee selection.
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                LibraryState.marquee-start(self.mouse-x / 1px, r * 116 + self.mouse-y / 1px, e.modifiers.shift || e.modifiers.control || e.modifiers.meta);
                            } else if e.kind == PointerEventKind.move && self.pressed {
                                LibraryState.marquee-move(self.mouse-x / 1px, r * 116 + self.mouse-y / 1px);
                            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                                LibraryState.marquee-end();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-m;
                        spacing: Theme.space-s;
                        alignment: start;
                        for cell in row.cells : CellView {
                            cell: cell;
                            pressed(shift, toggle) => { LibraryState.cell-pressed(cell.index, shift, toggle); }
                            dragged(x, y) => { LibraryState.cell-drag-moved(cell.index, x, y); }
                            released(x, y) => { LibraryState.cell-released(cell.index, x, y); }
                            double-clicked => { LibraryState.cell-double-clicked(cell.index); }
                            shown => { LibraryState.cell-shown(cell.index); }
                        }
                    }
                }
            }
            if LibraryState.marquee-visible : Rectangle {
                x: LibraryState.marquee-x * 1px;
                y: LibraryState.marquee-y * 1px + lv.content-y;
                width: LibraryState.marquee-w * 1px;
                height: LibraryState.marquee-h * 1px;
                background: Theme.selection-tint;
                border-width: 1px;
                border-color: Theme.selection;
            }
            if root.rows.length == 0 && root.total-count == 0 : EmptyState {
                icon: Icons.image-multiple;
                title: @tr("Your library is empty");
                description: @tr("Add the photos, videos and music for your slideshow. Files stay where they are; nothing is copied.");
                action-text: @tr("Add folder…");
                secondary-text: @tr("Add files…");
                action => { LibraryState.add-folder(); }
                secondary => { LibraryState.add-files(); }
            }
            if root.rows.length == 0 && root.total-count > 0 : EmptyState {
                icon: Icons.search;
                title: @tr("Nothing matches your search");
                description: @tr("Try another word or set the type filter to \"All\".");
            }
        }
        Divider { }
        // Selection actions (NN/G bulk actions: contextual bar with count).
        Bar {
            side-padding: Theme.space-l;
                ActionButton {
                    text: LibraryState.selected-count > 1 ? @tr("Add {} to timeline", LibraryState.selected-count) : @tr("Add to timeline");
                    primary: true;
                    enabled: LibraryState.selected-count > 0;
                    clicked => { LibraryState.add-selected-to-timeline(); }
                }
                ActionButton {
                    text: @tr("Add all");
                    enabled: root.rows.length > 0;
                    clicked => { LibraryState.add-all-to-timeline(); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: root.details-open ? Icons.chevron-down : Icons.chevron-up;
                    tooltip: root.details-open ? @tr("Hide details") : @tr("Show details");
                    enabled: root.inspector.visible;
                    clicked => { root.details-open = !root.details-open; }
                }
        }
        // Details (collapsible inspector for the selected item).
        if root.details-open && root.inspector.visible : Rectangle {
            height: 200px;
            background: Theme.surface-window;
            HorizontalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;
                Rectangle {
                    width: 120px;
                    border-radius: Theme.radius-m;
                    background: Theme.surface-card;
                    clip: true;
                    if LibraryState.inspector-has-image : Image {
                        source: LibraryState.inspector-image;
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                VerticalLayout {
                    spacing: Theme.space-xs;
                    alignment: start;
                    BodyText { text: root.inspector.title; font-weight: Theme.weight-semibold; }
                    InfoRow { label: @tr("Type"); value: root.inspector.kind == 0 ? @tr("Photo") : root.inspector.kind == 1 ? @tr("Video") : root.inspector.kind == 2 ? @tr("Audio") : @tr("Unknown"); }
                    InfoRow { label: @tr("Dimensions"); value: root.inspector.dimensions; }
                    InfoRow { label: @tr("Duration"); value: root.inspector.duration; }
                    InfoRow { label: @tr("Captured"); value: root.inspector.captured; }
                    InfoRow { label: @tr("File size"); value: root.inspector.size; }
                    InfoRow { label: @tr("Status"); value: root.inspector.status-kind == 0 ? @tr("Reading metadata…") : root.inspector.status-kind == 1 ? @tr("Ready") : root.inspector.status-kind == 3 ? @tr("Not downloaded") : @tr("Error: {}", root.inspector.error); }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        if root.inspector.hdr : Rectangle {
                            background: Theme.warning;
                            border-radius: Theme.radius-s;
                            height: Theme.control-height;
                            width: 44px;
                            Text { text: "HDR"; color: Theme.on-warning; font-size: Theme.font-caption; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        ActionButton { text: @tr("Show in folder"); icon: Icons.folder-open; clicked => { LibraryState.reveal-selected(); } }
                        ActionButton { text: @tr("Remove from library"); icon: Icons.delete; clicked => { LibraryState.remove-selected(); } }
                    }
                }
            }
        }
        Divider { }
        // Status bar: import progress (visibility of system status).
        Rectangle {
            height: Theme.statusbar-height;
            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-s;
                spacing: Theme.space-s;
                Caption {
                    text: LibraryState.status-kind == 1 ? @tr("Scanning…")
                        : LibraryState.status-kind == 2 ? @tr("Adding {} of {}…", LibraryState.import-done, LibraryState.import-total)
                        : LibraryState.status-kind == 3 ? @tr("Added {} files, {} were already in the library.", LibraryState.import-added, LibraryState.import-existing)
                        : (LibraryState.selected-count > 0 ? (LibraryState.selected-count == 1 ? @tr("1 selected") : @tr("{} selected", LibraryState.selected-count)) : "");
                    horizontal-stretch: 1;
                }
                if LibraryState.status-kind == 1 || LibraryState.status-kind == 2 : ProgressIndicator {
                    width: 80px;
                    progress: LibraryState.import-total > 0 ? LibraryState.import-done / LibraryState.import-total : 0;
                    indeterminate: LibraryState.status-kind == 1;
                }
            }
        }
    }

    // Active drop zone (NN/G drag and drop: signal the zone while hovering).
    if LibraryState.drop-hover : Rectangle {
        background: Theme.drop-target;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.radius-l;
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-m;
            padding: Theme.space-xl;
            HorizontalLayout { alignment: center; Icon { source: Icons.image-multiple; size: 40px; color: Theme.text; } }
            Text {
                text: @tr("Drop to add to your library");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
