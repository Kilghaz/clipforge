import { Button, ComboBox, Switch, Slider, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Shell } from "shell.slint";
import { LibraryState } from "library.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton, ChoiceButton, ChoiceGroup, Bar, Section, SectionLabel, Caption, BodyText, Title, SecondaryText, Divider, VDivider, Badge, EmptyState, DialogFrame, DialogButtons } from "components.slint";

/// Where the timeline strip is on screen, for cross-panel drops.
export struct StripRect {
    x: float,
    y: float,
    width: float,
    height: float,
    /// Horizontal scroll offset of the strip content (px, >= 0).
    scroll: float,
}

export struct TimelineClip {
    index: int,
    id: string,
    title: string,
    thumb: image,
    has-thumb: bool,
    x: float,
    width: float,
    overlap: float,
    selected: bool,
    duration-text: string,
    // Index into the transition picker (TransitionKind::ALL); 0 = cut,
    // 1–3 dissolve and fades, 4+ movement transitions.
    transition: int,
    is-video: bool,
    muted: bool,
    /// Photo with a Ken Burns movement.
    moving: bool,
    /// Keyboard focus (drawn only while the strip has keyboard focus).
    focused: bool,
}

/// All editor state, owned and driven by Rust.
export global EditorState {
    in-out property <[TimelineClip]> clips;
    in-out property <float> strip-width;
    in-out property <float> playhead-x;
    in-out property <string> time-text;
    in-out property <string> total-text;
    in-out property <image> preview;
    in-out property <bool> playing;
    in-out property <float> pixels-per-second: 40;
    in-out property <int> selected-count;
    in-out property <int> clip-count;
    in-out property <int> drop-marker: -1;
    in-out property <float> drop-marker-x;

    // Inspector (reflects selection or, if none, the defaults).
    in-out property <float> duration-seconds: 4;
    in-out property <int> fit-index;
    in-out property <int> transition-index;
    in-out property <float> transition-seconds: 1;
    /// The chosen duration is shortened on some target (neighbour too short).
    in-out property <bool> transition-capped;
    /// Targets include photos (shows the Motion section) / also videos.
    in-out property <bool> has-photo-target: true;
    in-out property <int> motion-index;
    /// Selection contains videos (shows audio controls) / only videos.
    in-out property <bool> has-video-target;
    in-out property <bool> only-video-target;
    in-out property <bool> muted;
    in-out property <float> volume-percent: 100;

    // Project
    in-out property <string> project-title;
    in-out property <bool> dirty;
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    in-out property <int> aspect-index;
    in-out property <string> status-text;

    // Export dialog
    in-out property <bool> export-open;
    in-out property <int> export-resolution-index;
    in-out property <int> export-quality-index: 1;
    in-out property <bool> export-youtube: true;
    // 0 idle, 1 running, 2 done, 3 failed
    in-out property <int> export-status: 0;
    in-out property <float> export-progress;
    in-out property <string> export-message;

    callback clip-pressed(int, bool, bool);
    callback clip-dragged(float);
    callback clip-released(float);
    callback scrub(float);
    callback toggle-play();
    callback zoom-changed(float);
    callback select-all();
    callback clear-selection();
    /// Timeline keyboard navigation (docs/ux/decisions/keyboard-navigation.md).
    /// ↑/↓: previous/next clip; mode 0 replace, 1 extend, 2 focus only.
    callback clip-navigate(bool, int);
    /// Enter: toggle the focused clip in the selection.
    callback toggle-focused-clip();
    /// Alt/Option+←/→: move the selected clips one position (true = later).
    callback nudge-clips(bool);
    /// Tab entered the strip: give it a focused clip.
    callback strip-focus-entered();
    /// Show the focus ring (last focus change came from the keyboard).
    in-out property <bool> focus-visible;
    /// Focused clip geometry for scroll-into-view; `focus-token` changes on
    /// every keyboard move.
    in-out property <float> focus-clip-x;
    in-out property <float> focus-clip-width;
    in-out property <int> focus-token;
    callback delete-selected();
    callback undo();
    callback redo();
    callback duration-changed(float);
    callback fit-changed(int);
    callback transition-changed(int, float);
    callback shuffle-transitions();
    callback motion-changed(int);
    callback shuffle-motion();
    callback rotate-selected();
    callback aspect-changed(int);
    callback muted-changed(bool);
    callback volume-changed(float);
    /// Trim handle drag: clip index, left edge?, pointer x in strip px.
    callback trim-dragged(int, bool, float);
    callback trim-released(int, bool, float);
    /// Step the playhead by whole frames (negative = back) or seconds.
    callback step-frames(int);
    callback step-seconds(float);
    callback pause();
    callback play();
    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-start();
    callback export-cancel();
}

/// Timeline clip: Spectrum "Card" with a type colour, selection ring,
/// transition overlay, mute badge and (videos) trim handles.
export component ClipView inherits Rectangle {
    in property <TimelineClip> item;
    /// Draw the keyboard focus ring (the strip decides).
    in property <bool> show-focus;
    /// Any press on the clip (body or trim handle), so the strip can take focus.
    callback pressed-any();
    property <bool> hovered: touch.has-hover || trim-left.has-hover || trim-right.has-hover;
    border-radius: Theme.radius-m;
    background: root.item.selected ? Theme.selection-tint : (touch.has-hover ? Theme.surface-card.brighter(0.15) : Theme.surface-card);
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? Theme.selection : Theme.border;
    clip: true;
    animate background { duration: Theme.motion-fast; }
    accessible-role: list-item;
    accessible-label: root.item.title + ", " + root.item.duration-text + (root.item.muted ? ", " + @tr("Muted") : "");
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed-any();
                EditorState.clip-pressed(root.item.index, e.modifiers.shift, e.modifiers.control || e.modifiers.meta);
            } else if e.kind == PointerEventKind.move && self.pressed {
                EditorState.clip-dragged(root.item.x + self.mouse-x / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.clip-released(root.item.x + self.mouse-x / 1px);
            }
        }
    }
    VerticalLayout {
        padding: 0;
        spacing: 0;
        // Type colour along the top edge (photo / video token).
        Rectangle { height: 3px; background: root.item.is-video ? Theme.video : Theme.photo; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-canvas;
            clip: true;
            if root.item.has-thumb : Image {
                source: root.item.thumb;
                image-fit: cover;
                width: parent.width;
                height: parent.height;
            }
            if !root.item.has-thumb : Icon {
                source: root.item.is-video ? Icons.video : Icons.image;
                size: Theme.icon-l;
                color: Theme.text-disabled;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        // Solid footer keeps the label legible over any footage.
        Rectangle {
            height: Theme.control-height-s;
            background: Theme.surface-card;
            HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: Theme.space-xs;
                Text { text: root.item.title; color: Theme.text; font-size: Theme.font-caption; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Caption { text: root.item.duration-text; }
            }
        }
    }
    // Transition into this clip, drawn over the overlap.
    if root.item.transition != 0 : Rectangle {
        x: 0;
        y: 0;
        width: max(root.item.overlap * 1px, 10px);
        height: parent.height;
        // Dissolves and fades blend; movement transitions (slide, wipe, zoom) move.
        background: root.item.transition <= 3 ? Theme.title-clip.with-alpha(0.4) : Theme.text.with-alpha(0.2);
        // End of the overlap: a light line on a dark backdrop reads on any
        // footage (the wash alone is too faint over bright pictures).
        // Stops above the footer so it never cuts through the clip name.
        Rectangle {
            x: parent.width - 3px;
            width: 3px;
            y: Theme.space-xs;
            height: parent.height - Theme.control-height-s - 2 * Theme.space-xs;
            background: Theme.badge-backdrop;
            Rectangle { x: 1px; width: 1px; height: parent.height; background: Theme.text; }
        }
    }
    // Badges sit at the left, just after this clip's own transition overlay:
    // the right end of a clip is covered by the next clip's overlap.
    property <length> badge-x: (root.item.transition != 0 ? max(root.item.overlap * 1px, 10px) : 0px) + Theme.space-s;
    if root.item.moving : Badge {
        x: root.badge-x;
        y: Theme.space-s;
        icon: Icons.arrow-move;
        label: @tr("Moves (Ken Burns)");
    }
    if root.item.is-video && root.item.muted : Badge {
        x: root.badge-x;
        y: Theme.space-s;
        icon: Icons.speaker-mute;
        label: @tr("Muted");
    }
    // Trim handles (videos only): drag the edges to change in/out points.
    // Shown on hover so the affordance is discoverable without clutter.
    // Keyboard focus ring, inset: neighbouring clips touch, and the clip
    // clips its children, so an outside ring would be cut off.
    if root.show-focus : Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: Theme.radius-m - 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    trim-left := TouchArea {
        x: 0;
        width: 16px;
        enabled: root.item.is-video;
        mouse-cursor: root.item.is-video ? MouseCursor.col-resize : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed-any(); }
            if e.kind == PointerEventKind.move && self.pressed {
                EditorState.trim-dragged(root.item.index, true, root.item.x + self.mouse-x / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.trim-released(root.item.index, true, root.item.x + self.mouse-x / 1px);
            }
        }
        if root.item.is-video : Rectangle { width: 4px; height: parent.height; x: 0; background: Theme.text; opacity: root.hovered || root.item.selected ? 0.7 : 0.25; animate opacity { duration: Theme.motion-fast; } }
    }
    trim-right := TouchArea {
        x: parent.width - 16px;
        width: 16px;
        enabled: root.item.is-video;
        mouse-cursor: root.item.is-video ? MouseCursor.col-resize : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed-any(); }
            if e.kind == PointerEventKind.move && self.pressed {
                EditorState.trim-dragged(root.item.index, false, root.item.x + (parent.width - 16px + self.mouse-x) / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.trim-released(root.item.index, false, root.item.x + (parent.width - 16px + self.mouse-x) / 1px);
            }
        }
        if root.item.is-video : Rectangle { width: 4px; height: parent.height; x: 12px; background: Theme.text; opacity: root.hovered || root.item.selected ? 0.7 : 0.25; animate opacity { duration: Theme.motion-fast; } }
    }
}

/// Labelled slider with a live value read-out (Spectrum "Slider").
export component ValueSlider inherits HorizontalLayout {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <bool> enabled: true;
    in property <string> value-text;
    in property <string> label;
    in-out property <float> value;
    callback released(float);
    spacing: Theme.space-s;
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        value <=> root.value;
        released(v) => { root.released(v); }
        accessible-label: root.label;
    }
    Text {
        text: root.value-text;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: Theme.font-secondary;
        width: 48px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

/// Timeline strip: time ruler, clips, playhead, drop and trim markers.
/// Ruler 24 px, clips 100 px, 8 px margins (DESIGN.md §4).
export component TimelineStrip inherits Rectangle {
    /// On-screen rectangle and scroll offset, for cross-panel drops.
    out property <StripRect> rect: {
        x: root.absolute-position.x / 1px,
        y: root.absolute-position.y / 1px,
        width: root.width / 1px,
        height: root.height / 1px,
        scroll: -flick.content-x / 1px,
    };
    property <length> ruler-height: 24px;
    property <length> clip-top: self.ruler-height + Theme.space-xs;
    property <length> clip-height: 100px;
    // One tick per second; a label every `label-step` seconds so
    // labels never crowd at low zoom.
    property <int> label-step: EditorState.pixels-per-second >= 80 ? 1 : (EditorState.pixels-per-second >= 40 ? 2 : (EditorState.pixels-per-second >= 20 ? 5 : 10));
    property <int> tick-count: ceil(flick.content-width / (EditorState.pixels-per-second * 1px)) + 1;
    height: self.clip-top + self.clip-height + Theme.space-s;
    background: Theme.surface-window;
    /// Moves keyboard focus into the strip (the editor forwards ↑/↓ here).
    public function focus-strip() { strip-focus.focus(); }
    /// Handles the timeline navigation keys; true when the key was used.
    public function nav-key(event: KeyEvent) -> bool {
        if event.text == Key.UpArrow || event.text == Key.DownArrow {
            EditorState.focus-visible = true;
            EditorState.clip-navigate(event.text == Key.DownArrow, event.modifiers.shift ? 1 : ((event.modifiers.control || event.modifiers.meta) ? 2 : 0));
            return true;
        }
        if event.modifiers.alt && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
            EditorState.focus-visible = true;
            EditorState.nudge-clips(event.text == Key.RightArrow);
            return true;
        }
        return false;
    }
    /// Scrolls so the focused clip is fully visible, with a small margin.
    function reveal-focused-clip() {
        if EditorState.focus-clip-width <= 0 { return; }
        if EditorState.focus-clip-x * 1px - Theme.space-l < -flick.content-x {
            flick.content-x = min(0px, -(EditorState.focus-clip-x * 1px - Theme.space-l));
        } else if (EditorState.focus-clip-x + EditorState.focus-clip-width) * 1px + Theme.space-l > -flick.content-x + flick.width {
            flick.content-x = -((EditorState.focus-clip-x + EditorState.focus-clip-width) * 1px + Theme.space-l - flick.width);
        }
    }
    property <int> focus-token: EditorState.focus-token;
    changed focus-token => { root.reveal-focused-clip(); }
    strip-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: list;
        accessible-label: @tr("Timeline clips");
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                EditorState.focus-visible = true;
                EditorState.strip-focus-entered();
            }
        }
        key-pressed(event) => {
            if root.nav-key(event) { return accept; }
            if event.text == Key.Return { EditorState.focus-visible = true; EditorState.toggle-focused-clip(); return accept; }
            return reject;
        }
        flick := Flickable {
            content-width: max(EditorState.strip-width * 1px + 200px, self.width);
            content-height: self.height;
            TouchArea {
                width: parent.content-width;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        EditorState.focus-visible = false;
                        strip-focus.focus();
                    }
                    if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move) && self.pressed {
                        EditorState.scrub(self.mouse-x / 1px);
                    }
                }
            }
            // Time ruler.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.content-width;
                height: root.ruler-height;
                background: Theme.surface-pane;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
                for i in root.tick-count : Rectangle {
                    x: i * EditorState.pixels-per-second * 1px;
                    y: parent.height - self.height;
                    width: 1px;
                    height: mod(i, root.label-step) == 0 ? 8px : 4px;
                    background: Theme.text-secondary;
                }
                for i in root.tick-count : Text {
                    visible: mod(i, root.label-step) == 0;
                    x: i * EditorState.pixels-per-second * 1px + Theme.space-xs;
                    y: 2px;
                    text: floor(i / 60) + ":" + (mod(i, 60) < 10 ? "0" : "") + mod(i, 60);
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                }
            }
            for clip in EditorState.clips : ClipView {
                item: clip;
                show-focus: clip.focused && strip-focus.has-focus && EditorState.focus-visible;
                pressed-any => {
                    EditorState.focus-visible = false;
                    strip-focus.focus();
                }
                x: clip.x * 1px;
                y: root.clip-top;
                width: clip.width * 1px;
                height: root.clip-height;
            }
            // Insertion point while dragging from the library.
            if EditorState.drop-marker >= 0 : Rectangle {
                x: EditorState.drop-marker-x * 1px - 1px;
                y: root.clip-top - Theme.space-xs;
                width: 3px;
                height: root.clip-height + Theme.space-s;
                background: Theme.accent;
            }
            // Playhead with a grab head in the ruler.
            Rectangle {
                x: EditorState.playhead-x * 1px - 1px;
                y: 0;
                width: 2px;
                height: parent.height;
                background: Theme.playhead;
            }
            Rectangle {
                x: EditorState.playhead-x * 1px - 6px;
                y: 0;
                width: 12px;
                height: 12px;
                border-radius: Theme.radius-s;
                background: Theme.playhead;
            }
        }
        if Shell.drag-over-timeline : Rectangle {
            background: Theme.drop-target;
            border-width: 2px;
            border-color: Theme.accent;
        }
    }
}



component Inspector inherits Rectangle {
    /// Keyboard: `T` jumps to the transition picker.
    public function focus-transition() { transition-picker.focus(); }
    background: Theme.surface-pane;
    width: 296px;
    ScrollView {
        VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-xl;
            alignment: start;
            // Context line: what the controls below apply to.
            VerticalLayout {
                spacing: Theme.space-xs;
                Title {
                    text: EditorState.selected-count == 0
                        ? (EditorState.clip-count == 0 ? @tr("New clips") : @tr("All clips"))
                        : (EditorState.selected-count == 1 ? @tr("1 clip selected") : @tr("{} clips selected", EditorState.selected-count));
                }
                Caption {
                    text: EditorState.selected-count == 0
                        ? (EditorState.clip-count == 0 ? @tr("Defaults for clips you add") : @tr("Nothing selected: changes apply to all {} clips", EditorState.clip-count))
                        : @tr("Changes apply to the selection");
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
            if !EditorState.only-video-target : Section {
                title: @tr("Photo duration");
                ValueSlider {
                    minimum: 0.5;
                    maximum: 20;
                    step: 0.5;
                    value <=> EditorState.duration-seconds;
                    value-text: round(EditorState.duration-seconds * 10) / 10 + " s";
                    label: @tr("Photo duration");
                    released(v) => { EditorState.duration-changed(v); }
                }
                ChoiceGroup {
                    label: @tr("Photo duration presets");
                    options: ["2 s", "3 s", "4 s", "5 s", "8 s"];
                    accessible-options: [@tr("2 seconds"), @tr("3 seconds"), @tr("4 seconds"), @tr("5 seconds"), @tr("8 seconds")];
                    selected-index: EditorState.duration-seconds == 2 ? 0 : EditorState.duration-seconds == 3 ? 1 : EditorState.duration-seconds == 4 ? 2 : EditorState.duration-seconds == 5 ? 3 : EditorState.duration-seconds == 8 ? 4 : -1;
                    changed(i) => {
                        EditorState.duration-seconds = i == 0 ? 2 : i == 1 ? 3 : i == 2 ? 4 : i == 3 ? 5 : 8;
                        EditorState.duration-changed(EditorState.duration-seconds);
                    }
                }
            }
            if EditorState.has-video-target : Section {
                title: @tr("Audio");
                Switch {
                    text: @tr("Mute");
                    checked <=> EditorState.muted;
                    toggled => { EditorState.muted-changed(self.checked); }
                }
                ValueSlider {
                    enabled: !EditorState.muted;
                    minimum: 0;
                    maximum: 200;
                    step: 5;
                    value <=> EditorState.volume-percent;
                    value-text: round(EditorState.volume-percent) + " %";
                    label: @tr("Volume");
                    released(v) => { EditorState.volume-changed(v); }
                }
                Caption { text: @tr("Drag the edges of a video clip to trim it."); wrap: word-wrap; overflow: clip; }
            }
            Section {
                title: @tr("Framing");
                ChoiceGroup {
                    label: @tr("Framing");
                    options: [@tr("Fit inside"), @tr("Fill frame")];
                    accessible-options: [@tr("Fit inside, with bars"), @tr("Fill frame, cropped")];
                    selected-index <=> EditorState.fit-index;
                    changed(i) => { EditorState.fit-changed(i); }
                }
                ActionButton { text: @tr("Rotate 90°"); icon: Icons.arrow-rotate-clockwise; clicked => { EditorState.rotate-selected(); } }
            }
            Section {
                title: @tr("Transition into clip");
                transition-picker := ComboBox {
                    height: Theme.control-height;
                    model: [
                        @tr("Cut"), @tr("Cross dissolve"), @tr("Fade through black"), @tr("Fade through white"),
                        @tr("Slide left"), @tr("Slide right"), @tr("Slide up"), @tr("Slide down"),
                        @tr("Wipe left"), @tr("Wipe right"), @tr("Wipe up"), @tr("Wipe down"),
                        @tr("Zoom"),
                    ];
                    current-index <=> EditorState.transition-index;
                    selected => { EditorState.transition-changed(self.current-index, EditorState.transition-seconds); }
                    accessible-label: @tr("Transition into clip");
                }
                ValueSlider {
                    enabled: EditorState.transition-index != 0;
                    minimum: 0.2;
                    maximum: 3;
                    step: 0.1;
                    value <=> EditorState.transition-seconds;
                    value-text: round(EditorState.transition-seconds * 10) / 10 + " s";
                    label: @tr("Transition duration");
                    released(v) => { EditorState.transition-changed(EditorState.transition-index, v); }
                }
                if EditorState.transition-capped && EditorState.transition-index != 0 : Caption {
                    text: @tr("Shortened where clips are too short");
                    wrap: word-wrap;
                    overflow: clip;
                }
                ActionButton {
                    text: @tr("Shuffle transitions");
                    icon: Icons.arrow-shuffle;
                    enabled: EditorState.clip-count > 0;
                    clicked => { EditorState.shuffle-transitions(); }
                }
            }
            if EditorState.has-photo-target : Section {
                title: @tr("Motion");
                ComboBox {
                    height: Theme.control-height;
                    model: [@tr("None"), @tr("Zoom in"), @tr("Zoom out"), @tr("Pan left"), @tr("Pan right"), @tr("Pan up"), @tr("Pan down")];
                    current-index <=> EditorState.motion-index;
                    selected => { EditorState.motion-changed(self.current-index); }
                    accessible-label: @tr("Motion");
                }
                Caption {
                    text: EditorState.has-video-target ? @tr("Slow zoom or pan across photos. Applies to photos only.") : @tr("Slow zoom or pan across photos.");
                    wrap: word-wrap;
                    overflow: clip;
                }
                ActionButton {
                    text: @tr("Shuffle motion");
                    icon: Icons.arrow-shuffle;
                    enabled: EditorState.clip-count > 0;
                    clicked => { EditorState.shuffle-motion(); }
                }
            }
            Divider { }
            Section {
                title: @tr("Project");
                ChoiceGroup {
                    label: @tr("Orientation");
                    options: [@tr("Landscape 16:9"), @tr("Portrait 9:16")];
                    selected-index <=> EditorState.aspect-index;
                    changed(i) => { EditorState.aspect-changed(i); }
                }
            }
            Section {
                title: @tr("Timeline");
                ActionButton { text: @tr("Select all"); icon: Icons.select-all; enabled: EditorState.clip-count > 0; clicked => { EditorState.select-all(); } }
                ActionButton {
                    text: EditorState.selected-count > 1 ? @tr("Remove {} from timeline", EditorState.selected-count) : @tr("Remove from timeline");
                    icon: Icons.delete;
                    enabled: EditorState.selected-count > 0;
                    clicked => { EditorState.delete-selected(); }
                }
            }
        }
    }
}

component ExportDialog inherits DialogFrame {
    title: @tr("Export video");
    dialog-width: 480px;
    dismissed => { if EditorState.export-status != 1 { EditorState.export-open = false; } }
    accepted => { if EditorState.export-status != 1 { EditorState.export-start(); } }
    Section {
        title: @tr("Resolution");
        ChoiceGroup {
            label: @tr("Resolution");
            options: [@tr("Full HD (1080p)"), @tr("4K (2160p)")];
            enabled: EditorState.export-status != 1;
            selected-index <=> EditorState.export-resolution-index;
        }
    }
    Section {
        title: @tr("Quality");
        ChoiceGroup {
            label: @tr("Quality");
            options: [@tr("Good"), @tr("Better"), @tr("Best")];
            enabled: EditorState.export-status != 1;
            selected-index <=> EditorState.export-quality-index;
        }
    }
    Switch { text: @tr("Optimize for YouTube"); checked <=> EditorState.export-youtube; enabled: EditorState.export-status != 1; }
    Caption { text: @tr("HDR export becomes available once HDR sources are supported."); wrap: word-wrap; overflow: clip; }
    if EditorState.export-status == 1 : ProgressIndicator { progress: EditorState.export-progress; }
    if EditorState.export-status != 0 : HorizontalLayout {
        spacing: Theme.space-s;
        if EditorState.export-status != 1 : Icon {
            source: EditorState.export-status == 2 ? Icons.checkmark-circle : Icons.error-circle;
            color: EditorState.export-status == 2 ? Theme.success : Theme.danger;
        }
        SecondaryText {
            text: EditorState.export-status == 1 ? @tr("Exporting… {}%", round(EditorState.export-progress * 100))
                : EditorState.export-status == 2 ? @tr("Saved to {}", EditorState.export-message)
                : @tr("Export failed: {}", EditorState.export-message);
            color: Theme.text;
            wrap: word-wrap;
            overflow: clip;
            horizontal-stretch: 1;
        }
    }
    DialogButtons {
        macos: Shell.macos;
        primary-text: @tr("Export…");
        primary-visible: EditorState.export-status != 1;
        secondary-text: EditorState.export-status == 1 ? @tr("Cancel") : @tr("Close");
        primary => { EditorState.export-start(); }
        secondary => { if EditorState.export-status == 1 { EditorState.export-cancel(); } else { EditorState.export-open = false; } }
    }
}

export component EditorPage inherits Rectangle {
    background: Theme.surface-window;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.meta || event.modifiers.control) && (event.text == "z" || event.text == "Z") {
                if event.modifiers.shift { EditorState.redo(); } else { EditorState.undo(); }
                return accept;
            }
            if (event.modifiers.meta || event.modifiers.control) && event.text == "y" { EditorState.redo(); return accept; }
            // ↑/↓ and Alt+←/→ work anywhere in the editor and move focus into the strip.
            if strip.nav-key(event) { strip.focus-strip(); return accept; }
            if (event.modifiers.meta || event.modifiers.control) && event.text == "a" { EditorState.select-all(); return accept; }
            if event.text == Key.Delete || event.text == Key.Backspace { EditorState.delete-selected(); return accept; }
            if event.text == Key.Space { EditorState.toggle-play(); return accept; }
            if event.text == "k" { EditorState.pause(); return accept; }
            if event.text == "l" { EditorState.play(); return accept; }
            if event.text == "j" { EditorState.step-seconds(-1); return accept; }
            if event.text == Key.LeftArrow { EditorState.step-frames(event.modifiers.shift ? -10 : -1); return accept; }
            if event.text == Key.RightArrow { EditorState.step-frames(event.modifiers.shift ? 10 : 1); return accept; }
            if event.text == Key.Home { EditorState.scrub(0); return accept; }
            if event.text == "t" && !event.modifiers.control && !event.modifiers.meta { inspector.focus-transition(); return accept; }
            if event.text == Key.End { EditorState.scrub(EditorState.strip-width); return accept; }
            if event.text == Key.Escape { EditorState.clear-selection(); return accept; }
            return reject;
        }

        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                // Toolbar
                Bar {
                    background: Theme.surface-pane;
                    side-padding: Theme.space-s;
                        IconButton {
                            icon: Shell.library-visible ? Icons.panel-left-contract : Icons.panel-left-expand;
                            tooltip: Shell.library-visible ? @tr("Hide library") : @tr("Show library");
                            clicked => { Shell.library-visible = !Shell.library-visible; }
                        }
                        IconButton { icon: Icons.arrow-undo; tooltip: Shell.macos ? @tr("Undo (⌘Z)") : @tr("Undo (Ctrl+Z)"); enabled: EditorState.can-undo; clicked => { EditorState.undo(); } }
                        IconButton { icon: Icons.arrow-redo; tooltip: Shell.macos ? @tr("Redo (⇧⌘Z)") : @tr("Redo (Ctrl+Shift+Z)"); enabled: EditorState.can-redo; clicked => { EditorState.redo(); } }
                        BodyText {
                            text: EditorState.project-title + (EditorState.dirty ? " •" : "");
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            min-width: 0;
                            accessible-label: @tr("Project title");
                        }
                        ActionButton { text: @tr("Export…"); icon: Icons.share; primary: true; enabled: EditorState.clip-count > 0; clicked => { EditorState.export-open = true; } }
                        IconButton { icon: Icons.settings; tooltip: @tr("Settings"); enabled: !EditorState.export-open; clicked => { Shell.settings-open = true; } }
                }
                Divider { }
                // Preview
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-canvas;
                    Image {
                        source: EditorState.preview;
                        image-fit: contain;
                        width: parent.width - 2 * Theme.space-l;
                        height: parent.height - 2 * Theme.space-l;
                        x: Theme.space-l;
                        y: Theme.space-l;
                    }
                    if EditorState.clip-count == 0 : EmptyState {
                        width: min(parent.width, 480px);
                        x: (parent.width - self.width) / 2;
                        height: parent.height;
                        icon: Icons.filmstrip;
                        title: @tr("Your slideshow is empty");
                        description: @tr("Double-click items in the library or drag them onto the timeline below. Everything you change can be undone.");
                        action-text: @tr("Add all from library");
                        action-enabled: LibraryState.total-count > 0;
                        action => { LibraryState.add-all-to-timeline(); }
                    }
                }
                Divider { }
                // Transport
                Bar {
                    bar-height: Theme.bar-height;
                    background: Theme.surface-pane;
                    side-padding: Theme.space-s;
                        IconButton {
                            icon: EditorState.playing ? Icons.pause : Icons.play;
                            tooltip: EditorState.playing ? @tr("Pause (Space)") : @tr("Play (Space)");
                            enabled: EditorState.clip-count > 0;
                            clicked => { EditorState.toggle-play(); }
                        }
                        // The time read-out never shrinks; the status message gives way.
                        SecondaryText { text: EditorState.time-text + " / " + EditorState.total-text; color: Theme.text; min-width: self.preferred-width; }
                        // Result of the last bulk action ("Shuffled transitions on 12 clips");
                        // Rust clears it after a few seconds.
                        Caption {
                            text: EditorState.status-text;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            overflow: elide;
                            min-width: 0;
                            accessible-role: text;
                        }
                        // Timeline zoom: icons at both ends label the slider.
                        Icon { source: Icons.zoom-out; size: Theme.icon-s; color: Theme.text-secondary; }
                        // Shrinks before anything else in narrow windows, so the
                        // transport never pushes the inspector out (900 px minimum).
                        Slider {
                            preferred-width: 120px;
                            min-width: 64px;
                            horizontal-stretch: 0;
                            minimum: 10;
                            maximum: 200;
                            value <=> EditorState.pixels-per-second;
                            changed(v) => { EditorState.zoom-changed(v); }
                            accessible-label: @tr("Timeline zoom");
                            Tooltip { text: @markdown("\{@tr("Timeline zoom")}"); }
                        }
                        Icon { source: Icons.zoom-in; size: Theme.icon-s; color: Theme.text-secondary; }
                }
                Divider { }
                // Timeline strip
                strip := TimelineStrip { }
            }
            VDivider { }
            inspector := Inspector { }
        }
    }
    if EditorState.export-open : ExportDialog { }

    /// On-screen rectangle of the timeline strip, for cross-panel drops.
    out property <StripRect> strip-rect: strip.rect;
}
