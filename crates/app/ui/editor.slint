import { Button, ComboBox, Switch, Slider, ProgressIndicator, ScrollView, TextEdit, SpinBox } from "std-widgets.slint";
// The bundled text fonts, so the inline editor shows the same letters as
// the rendered video (docs/ux/decisions/m5b-text-track.md).
import "../../../assets/fonts/InterVariable.ttf";
import "../../../assets/fonts/Montserrat.ttf";
import "../../../assets/fonts/PlayfairDisplay.ttf";
import "../../../assets/fonts/BebasNeue.ttf";
import "../../../assets/fonts/DancingScript.ttf";
import "../../../assets/fonts/Caveat.ttf";
import { Shell } from "shell.slint";
import { LibraryState } from "library.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton, ChoiceButton, ChoiceGroup, Bar, Section, SectionLabel, Caption, BodyText, Title, SecondaryText, Divider, VDivider, Badge, EmptyState, DialogFrame, DialogButtons, SwatchGroup, SongRow, FontPicker, IconChoiceGroup } from "components.slint";

/// Where the timeline strip is on screen, for cross-panel drops.
export struct StripRect {
    x: float,
    y: float,
    width: float,
    height: float,
    /// Horizontal scroll offset of the strip content (px, >= 0).
    scroll: float,
}

export struct TimelineClip {
    index: int,
    id: string,
    title: string,
    thumb: image,
    has-thumb: bool,
    x: float,
    width: float,
    overlap: float,
    selected: bool,
    duration-text: string,
    // Index into the transition picker (TransitionKind::ALL); 0 = cut,
    // 1–3 dissolve and fades, 4+ movement transitions.
    transition: int,
    is-video: bool,
    muted: bool,
    /// Photo with a Ken Burns movement.
    moving: bool,
    /// Keyboard focus (drawn only while the strip has keyboard focus).
    focused: bool,
    /// Colour card: drawn as its background colour.
    is-title: bool,
    title-bg: color,
}

/// One text on the text lane (strip x scale).
export struct TextBlockView {
    index: int,
    x: float,
    width: float,
    row: int,
    title: string,
    selected: bool,
    /// Keyboard focus on the lane.
    focused: bool,
}

/// A text visible at the playhead: its box as fractions of the picture.
export struct PreviewText {
    index: int,
    x: float,
    y: float,
    width: float,
    height: float,
    selected: bool,
}

/// One song block on the music lane (strip x scale).
export struct SongBlockView {
    x: float,
    width: float,
    title: string,
    /// Second or later pass of a looped playlist.
    repeat: bool,
}

/// One entry of the playlist in the inspector.
export struct SongItem {
    title: string,
    duration-text: string,
}

/// All editor state, owned and driven by Rust.
export global EditorState {
    in-out property <[TimelineClip]> clips;
    in-out property <float> strip-width;
    in-out property <float> playhead-x;
    in-out property <string> time-text;
    in-out property <string> total-text;
    in-out property <image> preview;
    in-out property <bool> playing;
    in-out property <float> pixels-per-second: 40;
    in-out property <int> selected-count;
    in-out property <int> clip-count;
    in-out property <int> drop-marker: -1;
    in-out property <float> drop-marker-x;

    // Inspector (reflects selection or, if none, the defaults).
    in-out property <float> duration-seconds: 4;
    in-out property <int> fit-index;
    in-out property <int> transition-index;
    in-out property <float> transition-seconds: 1;
    /// The chosen duration is shortened on some target (neighbour too short).
    in-out property <bool> transition-capped;
    /// Targets include photos (shows the Motion section) / also videos.
    in-out property <bool> has-photo-target: true;
    in-out property <int> motion-index;
    /// Selection contains videos (shows audio controls) / only videos.
    in-out property <bool> has-video-target;
    in-out property <bool> only-video-target;
    in-out property <bool> muted;
    in-out property <float> volume-percent: 100;
    /// Targets are only title cards (hides framing, renames duration).
    in-out property <bool> only-title-target;
    /// Targets include title cards (shows the background swatches).
    in-out property <bool> has-title-target;
    in-out property <int> title-background-index;

    // Text track (docs/ux/decisions/m5b-text-track.md).
    in-out property <[TextBlockView]> text-blocks;
    in-out property <int> text-rows: 1;
    /// Width / height of the video frame (for the preview overlay).
    in-out property <float> frame-aspect: 1.7778;
    in-out property <[PreviewText]> preview-texts;
    /// Snap guide lines as picture fractions (-1: none).
    in-out property <float> guide-x: -1;
    in-out property <float> guide-y: -1;
    /// Text being edited in place (-1: none) and how it looks.
    in-out property <int> editing-index: -1;
    in-out property <string> editing-text;
    in-out property <string> editing-family;
    /// Font size as a fraction of the picture's short side.
    in-out property <float> editing-size: 0.06;
    in-out property <color> editing-color;
    in-out property <bool> editing-bold;
    in-out property <bool> editing-italic;
    in-out property <int> editing-align: 1;
    in-out property <bool> editing-shadow;
    in-out property <bool> editing-box;
    in-out property <color> editing-box-color;
    // Text inspector (first selected text).
    in-out property <int> text-selected-count;
    in-out property <string> text-content;
    in-out property <bool> text-mixed;
    in-out property <string> text-font: "Inter Variable";
    /// Families matching the font search, best first.
    in-out property <[string]> font-matches;
    in-out property <int> text-points: 64;
    in-out property <bool> text-underline;
    in-out property <bool> text-bold;
    in-out property <bool> text-italic;
    in-out property <int> text-align-index: 1;
    in-out property <int> text-color-index;
    in-out property <bool> text-box;
    in-out property <int> text-box-color-index: 1;
    in-out property <bool> text-shadow: true;
    in-out property <float> text-duration: 4;
    in-out property <int> text-enter-index: 1;
    in-out property <float> text-enter-seconds: 0.5;
    in-out property <int> text-exit-index: 1;
    in-out property <float> text-exit-seconds: 0.5;

    // Music.
    in-out property <[SongBlockView]> song-blocks;
    in-out property <float> music-fade-x;
    in-out property <float> music-end-x;
    in-out property <bool> music-selected;
    in-out property <[SongItem]> songs;
    in-out property <float> music-volume: 100;
    in-out property <float> music-fade-in: 0;
    in-out property <float> music-fade-out: 3;
    in-out property <bool> music-loop: true;
    in-out property <bool> music-duck: true;
    in-out property <string> music-length-text;
    in-out property <string> show-length-text;
    in-out property <bool> can-fit-music;

    // Project
    in-out property <string> project-title;
    in-out property <bool> dirty;
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    in-out property <int> aspect-index;
    in-out property <string> status-text;

    // Export dialog
    in-out property <bool> export-open;
    in-out property <int> export-resolution-index;
    in-out property <int> export-quality-index: 1;
    in-out property <bool> export-youtube: true;
    // 0 idle, 1 running, 2 done, 3 failed
    in-out property <int> export-status: 0;
    in-out property <float> export-progress;
    in-out property <string> export-message;

    callback clip-pressed(int, bool, bool);
    callback clip-dragged(float);
    callback clip-released(float);
    callback scrub(float);
    callback toggle-play();
    callback zoom-changed(float);
    callback select-all();
    callback clear-selection();
    /// Timeline keyboard navigation (docs/ux/decisions/keyboard-navigation.md).
    /// ↑/↓: previous/next clip; mode 0 replace, 1 extend, 2 focus only.
    callback clip-navigate(bool, int);
    /// Enter: toggle the focused clip in the selection.
    callback toggle-focused-clip();
    /// Alt/Option+←/→: move the selected clips one position (true = later).
    callback nudge-clips(bool);
    /// Tab entered the strip: give it a focused clip.
    callback strip-focus-entered();
    /// Show the focus ring (last focus change came from the keyboard).
    in-out property <bool> focus-visible;
    /// Focused clip geometry for scroll-into-view; `focus-token` changes on
    /// every keyboard move.
    in-out property <float> focus-clip-x;
    in-out property <float> focus-clip-width;
    in-out property <int> focus-token;
    callback delete-selected();
    callback undo();
    callback redo();
    callback duration-changed(float);
    callback fit-changed(int);
    callback transition-changed(int, float);
    callback shuffle-transitions();
    callback motion-changed(int);
    callback shuffle-motion();
    callback rotate-selected();
    callback aspect-changed(int);
    callback muted-changed(bool);
    callback volume-changed(float);
    /// Trim handle drag: clip index, left edge?, pointer x in strip px.
    callback trim-dragged(int, bool, float);
    callback trim-released(int, bool, float);
    /// Step the playhead by whole frames (negative = back) or seconds.
    callback step-frames(int);
    callback step-seconds(float);
    callback pause();
    callback play();
    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-start();
    callback export-cancel();
    // Texts.
    callback add-text();
    /// Keyboard on the text lane: Tab entered, ←/→, Enter / Space.
    callback text-lane-focus-entered();
    callback text-lane-navigate(bool);
    callback text-lane-activate();
    /// Lane press: text index, shift, ctrl/cmd, part (0 body, 1 left edge, 2 right edge), strip x.
    callback text-lane-pressed(int, bool, bool, int, float);
    callback text-lane-dragged(float);
    callback text-lane-double-clicked(float);
    /// End of a lane or preview drag.
    callback text-released();
    /// Preview press on a text or a handle (0 move, 1 left side, 2 right side, 3 corner) at picture fractions.
    callback preview-text-pressed(int, int, float, float);
    callback preview-text-dragged(float, float);
    callback preview-background-pressed();
    callback preview-text-double-clicked(int);
    callback edit-selected-text();
    callback inline-edit-finished();
    callback text-typed(string);
    callback text-typing-done();
    /// Arrow keys with texts selected: direction and Shift.
    callback text-nudge(int, int, bool);
    callback text-font-search(string);
    callback text-font-changed(string);
    callback text-points-changed(int);
    callback text-underline-changed(bool);
    callback text-bold-changed(bool);
    callback text-italic-changed(bool);
    callback text-align-changed(int);
    callback text-color-changed(int);
    callback text-box-changed(bool);
    callback text-box-color-changed(int);
    callback text-shadow-changed(bool);
    callback text-duration-changed(float);
    callback text-enter-changed(int, float);
    callback text-exit-changed(int, float);
    callback title-background-changed(int);
    callback add-opening-title();
    callback add-closing-card();
    // Music.
    callback music-lane-pressed();
    callback add-music();
    callback remove-all-songs();
    callback song-move(int, bool);
    callback song-remove(int);
    callback music-volume-changed(float);
    callback music-fades-changed(float, float);
    callback music-loop-changed(bool);
    callback music-duck-changed(bool);
    callback fit-to-music();
}

/// Timeline clip: Spectrum "Card" with a type colour, selection ring,
/// transition overlay, mute badge and (videos) trim handles.
export component ClipView inherits Rectangle {
    in property <TimelineClip> item;
    /// Draw the keyboard focus ring (the strip decides).
    in property <bool> show-focus;
    /// Any press on the clip (body or trim handle), so the strip can take focus.
    callback pressed-any();
    property <bool> hovered: touch.has-hover || trim-left.has-hover || trim-right.has-hover;
    border-radius: Theme.radius-m;
    background: root.item.selected ? Theme.selection-tint : (touch.has-hover ? Theme.surface-card.brighter(0.15) : Theme.surface-card);
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? Theme.selection : Theme.border;
    clip: true;
    animate background { duration: Theme.motion-fast; }
    accessible-role: list-item;
    accessible-label: (root.item.is-title ? @tr("Colour card") : root.item.title) + ", " + root.item.duration-text + (root.item.muted ? ", " + @tr("Muted") : "");
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed-any();
                EditorState.clip-pressed(root.item.index, e.modifiers.shift, e.modifiers.control || e.modifiers.meta);
            } else if e.kind == PointerEventKind.move && self.pressed {
                EditorState.clip-dragged(root.item.x + self.mouse-x / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.clip-released(root.item.x + self.mouse-x / 1px);
            }
        }
    }
    VerticalLayout {
        padding: 0;
        spacing: 0;
        // Type colour along the top edge (photo / video / title token).
        Rectangle { height: 3px; background: root.item.is-title ? Theme.title-clip : (root.item.is-video ? Theme.video : Theme.photo); }
        Rectangle {
            vertical-stretch: 1;
            background: root.item.is-title ? root.item.title-bg : Theme.surface-canvas;
            clip: true;
            if root.item.has-thumb && !root.item.is-title : Image {
                source: root.item.thumb;
                image-fit: cover;
                width: parent.width;
                height: parent.height;
            }
            if !root.item.has-thumb && !root.item.is-title : Icon {
                source: root.item.is-video ? Icons.video : Icons.image;
                size: Theme.icon-l;
                color: Theme.text-disabled;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        // Solid footer keeps the label legible over any footage.
        Rectangle {
            height: Theme.control-height-s;
            background: Theme.surface-card;
            HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: Theme.space-xs;
                Text { text: root.item.is-title ? @tr("Colour card") : root.item.title; color: Theme.text; font-size: Theme.font-caption; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Caption { text: root.item.duration-text; }
            }
        }
    }
    // Transition into this clip, drawn over the overlap.
    if root.item.transition != 0 : Rectangle {
        x: 0;
        y: 0;
        width: max(root.item.overlap * 1px, 10px);
        height: parent.height;
        // Dissolves and fades blend; movement transitions (slide, wipe, zoom) move.
        background: root.item.transition <= 3 ? Theme.title-clip.with-alpha(0.4) : Theme.text.with-alpha(0.2);
        // End of the overlap: a light line on a dark backdrop reads on any
        // footage (the wash alone is too faint over bright pictures).
        // Stops above the footer so it never cuts through the clip name.
        Rectangle {
            x: parent.width - 3px;
            width: 3px;
            y: Theme.space-xs;
            height: parent.height - Theme.control-height-s - 2 * Theme.space-xs;
            background: Theme.badge-backdrop;
            Rectangle { x: 1px; width: 1px; height: parent.height; background: Theme.text; }
        }
    }
    // Badges sit at the left, just after this clip's own transition overlay:
    // the right end of a clip is covered by the next clip's overlap.
    property <length> badge-x: (root.item.transition != 0 ? max(root.item.overlap * 1px, 10px) : 0px) + Theme.space-s;
    if root.item.moving : Badge {
        x: root.badge-x;
        y: Theme.space-s;
        icon: Icons.arrow-move;
        label: @tr("Moves (Ken Burns)");
    }
    if root.item.is-video && root.item.muted : Badge {
        x: root.badge-x;
        y: Theme.space-s;
        icon: Icons.speaker-mute;
        label: @tr("Muted");
    }
    // Trim handles (videos only): drag the edges to change in/out points.
    // Shown on hover so the affordance is discoverable without clutter.
    // Keyboard focus ring, inset: neighbouring clips touch, and the clip
    // clips its children, so an outside ring would be cut off.
    if root.show-focus : Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: Theme.radius-m - 2px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    trim-left := TouchArea {
        x: 0;
        width: 16px;
        enabled: root.item.is-video;
        mouse-cursor: root.item.is-video ? MouseCursor.col-resize : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed-any(); }
            if e.kind == PointerEventKind.move && self.pressed {
                EditorState.trim-dragged(root.item.index, true, root.item.x + self.mouse-x / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.trim-released(root.item.index, true, root.item.x + self.mouse-x / 1px);
            }
        }
        if root.item.is-video : Rectangle { width: 4px; height: parent.height; x: 0; background: Theme.text; opacity: root.hovered || root.item.selected ? 0.7 : 0.25; animate opacity { duration: Theme.motion-fast; } }
    }
    trim-right := TouchArea {
        x: parent.width - 16px;
        width: 16px;
        enabled: root.item.is-video;
        mouse-cursor: root.item.is-video ? MouseCursor.col-resize : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed-any(); }
            if e.kind == PointerEventKind.move && self.pressed {
                EditorState.trim-dragged(root.item.index, false, root.item.x + (parent.width - 16px + self.mouse-x) / 1px);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                EditorState.trim-released(root.item.index, false, root.item.x + (parent.width - 16px + self.mouse-x) / 1px);
            }
        }
        if root.item.is-video : Rectangle { width: 4px; height: parent.height; x: 12px; background: Theme.text; opacity: root.hovered || root.item.selected ? 0.7 : 0.25; animate opacity { duration: Theme.motion-fast; } }
    }
}

/// Labelled slider with a live value read-out (Spectrum "Slider").
export component ValueSlider inherits HorizontalLayout {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <bool> enabled: true;
    in property <string> value-text;
    in property <string> label;
    in-out property <float> value;
    callback released(float);
    spacing: Theme.space-s;
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        value <=> root.value;
        released(v) => { root.released(v); }
        accessible-label: root.label;
    }
    Text {
        text: root.value-text;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        font-size: Theme.font-secondary;
        width: 48px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

/// Text lane above the clips (Premiere text track): one block per text on
/// the strip's time scale; overlapping texts stack into rows. Drag a block
/// to move it in time, its edges to trim; double-click empty space to add.
export component TextLane inherits Rectangle {
    in property <[TextBlockView]> blocks;
    in property <int> rows: 1;
    in property <length> row-height: 28px;
    /// Visible width of the strip, so the empty hint stays in view.
    in property <length> viewport-width;
    /// Draw the keyboard focus ring on the focused block.
    in property <bool> show-focus;
    height: root.rows * root.row-height;
    background: Theme.surface-pane;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: list;
    accessible-label: @tr("Text track");
    // Empty space: a press scrubs (the strip handles it), a double-click adds.
    TouchArea {
        double-clicked => { EditorState.text-lane-double-clicked(self.mouse-x / 1px); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                EditorState.scrub(self.mouse-x / 1px);
            }
        }
    }
    if root.blocks.length == 0 : HorizontalLayout {
        x: 0;
        width: min(parent.width, root.viewport-width);
        padding-left: Theme.space-s;
        spacing: Theme.space-s;
        alignment: start;
        Icon { source: Icons.text-t; size: Theme.icon-s; color: Theme.text-secondary; y: (parent.height - self.height) / 2; }
        Caption { text: @tr("Double-click to add text"); vertical-alignment: center; }
    }
    for b in root.blocks : Rectangle {
        x: b.x * 1px + 1px;
        y: b.row * root.row-height + 2px;
        width: max(b.width * 1px - 2px, 1px);
        height: root.row-height - 4px;
        border-radius: Theme.radius-s;
        background: b.selected ? Theme.text-track.with-alpha(0.85) : Theme.text-track.with-alpha(body.has-hover ? 0.6 : 0.45);
        border-width: b.selected ? 2px : 0;
        border-color: Theme.selection;
        clip: true;
        accessible-role: list-item;
        accessible-label: b.title;
        accessible-item-selectable: true;
        accessible-item-selected: b.selected;
        HorizontalLayout {
            padding-left: Theme.space-s;
            padding-right: Theme.space-s;
            spacing: Theme.space-xs;
            Icon { source: Icons.text-t; size: Theme.icon-s; color: Theme.text; y: (parent.height - self.height) / 2; }
            Text { text: b.title; color: Theme.text; font-size: Theme.font-caption; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; min-width: 0; }
        }
        if root.show-focus && b.focused : Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: Theme.radius-s;
            border-width: 2px;
            border-color: Theme.focus-ring;
        }
        body := TouchArea {
            double-clicked => { EditorState.preview-text-double-clicked(b.index); }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    EditorState.text-lane-pressed(b.index, e.modifiers.shift, e.modifiers.control || e.modifiers.meta, 0, b.x + self.mouse-x / 1px);
                } else if e.kind == PointerEventKind.move && self.pressed {
                    EditorState.text-lane-dragged(b.x + self.mouse-x / 1px);
                } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    EditorState.text-released();
                }
            }
        }
        for edge[i] in [0, 1] : TouchArea {
            x: edge == 0 ? 0 : parent.width - 8px;
            width: 8px;
            mouse-cursor: col-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    EditorState.text-lane-pressed(b.index, false, false, edge + 1, b.x + self.x / 1px + self.mouse-x / 1px);
                } else if e.kind == PointerEventKind.move && self.pressed {
                    EditorState.text-lane-dragged(b.x + self.x / 1px + self.mouse-x / 1px);
                } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    EditorState.text-released();
                }
            }
            if b.selected || body.has-hover : Rectangle {
                x: edge == 0 ? 0 : parent.width - 3px;
                width: 3px;
                background: Theme.text;
                opacity: 0.6;
            }
        }
    }
}

/// On-preview text editing (Canva / Keynote style): hit areas for the texts
/// visible at the playhead, the selection box with side handles (wrap
/// width) and corner handles (size), centre snap guides and the inline
/// editor. Laid over the picture rectangle.
export component TextOverlay inherits Rectangle {
    /// The picture's size in the overlay (image-fit contain).
    property <length> pic-w: min(root.width, root.height * EditorState.frame-aspect);
    property <length> pic-h: root.pic-w / EditorState.frame-aspect;
    property <length> pic-x: (root.width - root.pic-w) / 2;
    property <length> pic-y: (root.height - root.pic-h) / 2;
    property <length> handle: 10px;
    // Empty picture space clears the text selection.
    TouchArea {
        x: root.pic-x;
        y: root.pic-y;
        width: root.pic-w;
        height: root.pic-h;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                EditorState.preview-background-pressed();
            }
        }
    }
    if EditorState.guide-x >= 0 : Rectangle {
        x: root.pic-x + root.pic-w * EditorState.guide-x;
        y: root.pic-y;
        width: 1px;
        height: root.pic-h;
        background: Theme.guide;
    }
    if EditorState.guide-y >= 0 : Rectangle {
        x: root.pic-x;
        y: root.pic-y + root.pic-h * EditorState.guide-y;
        width: root.pic-w;
        height: 1px;
        background: Theme.guide;
    }
    for t in EditorState.preview-texts : text-box := Rectangle {
        x: root.pic-x + t.x * root.pic-w;
        y: root.pic-y + t.y * root.pic-h;
        width: t.width * root.pic-w;
        height: t.height * root.pic-h;
        property <bool> editing: t.index == EditorState.editing-index;
        accessible-role: button;
        accessible-label: @tr("Text on the preview");
        // Hover outline shows what can be grabbed.
        border-width: t.selected || editing ? 1px : (move.has-hover ? 1px : 0);
        border-color: t.selected || editing ? Theme.selection : Theme.text.with-alpha(0.6);
        move := TouchArea {
            mouse-cursor: editing ? MouseCursor.text : MouseCursor.move;
            enabled: !editing;
            double-clicked => { EditorState.preview-text-double-clicked(t.index); }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    EditorState.preview-text-pressed(t.index, 0, (parent.x - root.pic-x + self.mouse-x) / root.pic-w, (parent.y - root.pic-y + self.mouse-y) / root.pic-h);
                } else if e.kind == PointerEventKind.move && self.pressed {
                    EditorState.preview-text-dragged((parent.x - root.pic-x + self.mouse-x) / root.pic-w, (parent.y - root.pic-y + self.mouse-y) / root.pic-h);
                } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    EditorState.text-released();
                }
            }
        }
        // Handles: corners scale (code 3), sides change the wrap width (1, 2).
        for h[i] in (t.selected && !editing) ? [
            { code: 3, fx: 0, fy: 0 }, { code: 3, fx: 1, fy: 0 }, { code: 3, fx: 0, fy: 1 }, { code: 3, fx: 1, fy: 1 },
            { code: 1, fx: 0, fy: 0.5 }, { code: 2, fx: 1, fy: 0.5 },
        ] : [] : Rectangle {
            x: h.fx * parent.width - root.handle / 2;
            y: h.fy * parent.height - root.handle / 2;
            width: root.handle;
            height: root.handle;
            background: Theme.text;
            border-width: 1px;
            border-color: Theme.selection;
            border-radius: Theme.radius-s / 2;
            TouchArea {
                mouse-cursor: h.code == 3 ? ((h.fx == h.fy) ? MouseCursor.nwse-resize : MouseCursor.nesw-resize) : MouseCursor.ew-resize;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        EditorState.preview-text-pressed(t.index, h.code, (text-box.x + parent.x - root.pic-x + self.mouse-x) / root.pic-w, (text-box.y + parent.y - root.pic-y + self.mouse-y) / root.pic-h);
                    } else if e.kind == PointerEventKind.move && self.pressed {
                        EditorState.preview-text-dragged((text-box.x + parent.x - root.pic-x + self.mouse-x) / root.pic-w, (text-box.y + parent.y - root.pic-y + self.mouse-y) / root.pic-h);
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        EditorState.text-released();
                    }
                }
            }
        }
        // Inline editor: same font, size, colour and alignment as the video.
        // Behind the inline editor: the box and an approximated shadow, so the
        // text looks like the rendered one while typing.
        if editing && EditorState.editing-box : Rectangle {
            x: -EditorState.editing-size * min(root.pic-w, root.pic-h) * 0.3;
            y: -EditorState.editing-size * min(root.pic-w, root.pic-h) * 0.3;
            width: parent.width + 2 * EditorState.editing-size * min(root.pic-w, root.pic-h) * 0.3;
            height: parent.height + 2 * EditorState.editing-size * min(root.pic-w, root.pic-h) * 0.3;
            background: EditorState.editing-box-color;
        }
        if editing && EditorState.editing-shadow && !EditorState.editing-box : Text {
            x: 1px;
            y: 2px;
            width: parent.width;
            height: parent.height;
            text: EditorState.editing-text;
            font-family: EditorState.editing-family;
            font-size: EditorState.editing-size * min(root.pic-w, root.pic-h);
            font-weight: EditorState.editing-bold ? 700 : 400;
            font-italic: EditorState.editing-italic;
            color: Theme.shadow;
            horizontal-alignment: EditorState.editing-align == 0 ? TextHorizontalAlignment.left : (EditorState.editing-align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center);
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if editing : editor := TextInput {
            width: parent.width;
            height: parent.height;
            text <=> EditorState.editing-text;
            font-family: EditorState.editing-family;
            font-size: EditorState.editing-size * min(root.pic-w, root.pic-h);
            font-weight: EditorState.editing-bold ? 700 : 400;
            font-italic: EditorState.editing-italic;
            color: EditorState.editing-color;
            horizontal-alignment: EditorState.editing-align == 0 ? TextHorizontalAlignment.left : (EditorState.editing-align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center);
            vertical-alignment: center;
            wrap: word-wrap;
            single-line: false;
            selection-background-color: Theme.selection-tint;
            accessible-label: @tr("Text");
            init => { self.focus(); self.select-all(); }
            edited => { EditorState.text-typed(self.text); }
            key-pressed(event) => {
                if event.text == Key.Escape { EditorState.inline-edit-finished(); return accept; }
                return reject;
            }
            changed has-focus => { if !self.has-focus { EditorState.inline-edit-finished(); } }
        }
    }
}

/// Music lane under the clips (Premiere / Clipchamp audio track): one
/// block per song on the strip's time scale, repeats of a looped playlist
/// dimmed, the fade-out as a darkening ramp. Clicking selects the music.
export component MusicLane inherits Rectangle {
    in property <[SongBlockView]> blocks;
    in property <float> fade-x;
    in property <float> end-x;
    in property <bool> selected;
    in property <int> song-count;
    /// Visible width of the strip, so the empty state stays in view.
    in property <length> viewport-width;
    in property <bool> show-focus;
    callback pressed;
    callback add-music;
    background: root.selected ? Theme.selection-tint : Theme.surface-pane;
    border-radius: Theme.radius-m;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.selection : Theme.border;
    accessible-role: button;
    accessible-label: root.song-count == 0 ? @tr("Music: no songs") : @tr("Music: {} songs", root.song-count);
    accessible-action-default => { root.pressed(); }
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.pressed(); }
        }
    }
    for b in root.blocks : Rectangle {
        x: b.x * 1px + 1px;
        y: Theme.space-xs;
        width: max(b.width * 1px - 2px, 1px);
        height: parent.height - 2 * Theme.space-xs;
        border-radius: Theme.radius-s;
        background: Theme.audio.with-alpha(b.repeat ? 0.22 : 0.45);
        clip: true;
        HorizontalLayout {
            padding-left: Theme.space-s;
            padding-right: Theme.space-s;
            spacing: Theme.space-xs;
            Icon { source: Icons.music-note; size: Theme.icon-s; color: Theme.text; y: (parent.height - self.height) / 2; }
            Text { text: b.title; color: Theme.text; font-size: Theme.font-caption; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; min-width: 0; }
        }
    }
    // Fade-out: the lane darkens towards the end of the music.
    if root.end-x > root.fade-x : Rectangle {
        x: root.fade-x * 1px;
        y: Theme.space-xs;
        width: (root.end-x - root.fade-x) * 1px;
        height: parent.height - 2 * Theme.space-xs;
        background: @linear-gradient(90deg, transparent 0%, Theme.surface-window 100%);
    }
    if root.blocks.length == 0 : HorizontalLayout {
        x: 0;
        width: min(parent.width, root.viewport-width);
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        alignment: start;
        Icon { source: Icons.music-note; size: Theme.icon-s; color: Theme.text-secondary; y: (parent.height - self.height) / 2; }
        Caption {
            text: root.song-count == 0 ? @tr("Drop songs here or") : @tr("{} songs play under the slideshow once it has clips", root.song-count);
            vertical-alignment: center;
            overflow: elide;
        }
        if root.song-count == 0 : ActionButton {
            text: @tr("Add music…");
            icon: Icons.add;
            y: (parent.height - self.height) / 2;
            clicked => { root.add-music(); }
        }
    }
    if root.show-focus : Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: Theme.radius-m - 1px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
}

/// Timeline strip: time ruler, clips, playhead, drop and trim markers.
/// Ruler 24 px, clips 100 px, 8 px margins (DESIGN.md §4).
export component TimelineStrip inherits Rectangle {
    /// On-screen rectangle and scroll offset, for cross-panel drops.
    out property <StripRect> rect: {
        x: root.absolute-position.x / 1px,
        y: root.absolute-position.y / 1px,
        width: root.width / 1px,
        height: root.height / 1px,
        scroll: -flick.content-x / 1px,
    };
    property <length> ruler-height: 24px;
    property <length> text-row-height: 28px;
    property <length> text-top: self.ruler-height + Theme.space-xs;
    property <length> clip-top: self.text-top + EditorState.text-rows * self.text-row-height + Theme.space-xs;
    property <length> clip-height: 100px;
    property <length> lane-top: self.clip-top + self.clip-height + Theme.space-xs;
    property <length> lane-height: Theme.bar-height;
    // One tick per second; a label every `label-step` seconds so
    // labels never crowd at low zoom.
    property <int> label-step: EditorState.pixels-per-second >= 80 ? 1 : (EditorState.pixels-per-second >= 40 ? 2 : (EditorState.pixels-per-second >= 20 ? 5 : 10));
    property <int> tick-count: ceil(flick.content-width / (EditorState.pixels-per-second * 1px)) + 1;
    height: self.lane-top + self.lane-height + Theme.space-s;
    background: Theme.surface-window;
    /// Moves keyboard focus into the strip (the editor forwards ↑/↓ here).
    public function focus-strip() { strip-focus.focus(); }
    /// Handles the timeline navigation keys; true when the key was used.
    public function nav-key(event: KeyEvent) -> bool {
        if event.text == Key.UpArrow || event.text == Key.DownArrow {
            EditorState.focus-visible = true;
            EditorState.clip-navigate(event.text == Key.DownArrow, event.modifiers.shift ? 1 : ((event.modifiers.control || event.modifiers.meta) ? 2 : 0));
            return true;
        }
        if event.modifiers.alt && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
            EditorState.focus-visible = true;
            EditorState.nudge-clips(event.text == Key.RightArrow);
            return true;
        }
        return false;
    }
    /// Scrolls so the focused clip is fully visible, with a small margin.
    function reveal-focused-clip() {
        if EditorState.focus-clip-width <= 0 { return; }
        if EditorState.focus-clip-x * 1px - Theme.space-l < -flick.content-x {
            flick.content-x = min(0px, -(EditorState.focus-clip-x * 1px - Theme.space-l));
        } else if (EditorState.focus-clip-x + EditorState.focus-clip-width) * 1px + Theme.space-l > -flick.content-x + flick.width {
            flick.content-x = -((EditorState.focus-clip-x + EditorState.focus-clip-width) * 1px + Theme.space-l - flick.width);
        }
    }
    property <int> focus-token: EditorState.focus-token;
    changed focus-token => { root.reveal-focused-clip(); }
    strip-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: list;
        accessible-label: @tr("Timeline clips");
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                EditorState.focus-visible = true;
                EditorState.strip-focus-entered();
            }
        }
        key-pressed(event) => {
            if root.nav-key(event) { return accept; }
            if event.text == Key.Return { EditorState.focus-visible = true; EditorState.toggle-focused-clip(); return accept; }
            return reject;
        }
        flick := Flickable {
            content-width: max(EditorState.strip-width * 1px + 200px, self.width);
            content-height: self.height;
            TouchArea {
                width: parent.content-width;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        EditorState.focus-visible = false;
                        strip-focus.focus();
                    }
                    if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move) && self.pressed {
                        EditorState.scrub(self.mouse-x / 1px);
                    }
                }
            }
            // Time ruler.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.content-width;
                height: root.ruler-height;
                background: Theme.surface-pane;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
                for i in root.tick-count : Rectangle {
                    x: i * EditorState.pixels-per-second * 1px;
                    y: parent.height - self.height;
                    width: 1px;
                    height: mod(i, root.label-step) == 0 ? 8px : 4px;
                    background: Theme.text-secondary;
                }
                for i in root.tick-count : Text {
                    visible: mod(i, root.label-step) == 0;
                    x: i * EditorState.pixels-per-second * 1px + Theme.space-xs;
                    y: 2px;
                    text: floor(i / 60) + ":" + (mod(i, 60) < 10 ? "0" : "") + mod(i, 60);
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                }
            }
            text-focus := FocusScope {
                x: 0;
                y: root.text-top;
                width: max(EditorState.strip-width * 1px, flick.width - Theme.space-s);
                height: EditorState.text-rows * root.text-row-height;
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation {
                        EditorState.focus-visible = true;
                        EditorState.text-lane-focus-entered();
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        EditorState.focus-visible = true;
                        EditorState.text-lane-navigate(event.text == Key.RightArrow);
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space {
                        EditorState.focus-visible = true;
                        EditorState.text-lane-activate();
                        return accept;
                    }
                    return reject;
                }
                TextLane {
                    width: parent.width;
                    rows: EditorState.text-rows;
                    row-height: root.text-row-height;
                    blocks: EditorState.text-blocks;
                    viewport-width: flick.width;
                    show-focus: text-focus.has-focus && EditorState.focus-visible;
                }
            }
            for clip in EditorState.clips : ClipView {
                item: clip;
                show-focus: clip.focused && strip-focus.has-focus && EditorState.focus-visible;
                pressed-any => {
                    EditorState.focus-visible = false;
                    strip-focus.focus();
                }
                x: clip.x * 1px;
                y: root.clip-top;
                width: clip.width * 1px;
                height: root.clip-height;
            }
            lane-focus := FocusScope {
                x: 0;
                y: root.lane-top;
                width: max(EditorState.strip-width * 1px, flick.width - Theme.space-s);
                height: root.lane-height;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        EditorState.focus-visible = true;
                        EditorState.music-lane-pressed();
                        return accept;
                    }
                    return reject;
                }
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation { EditorState.focus-visible = true; }
                }
                MusicLane {
                    blocks: EditorState.song-blocks;
                    fade-x: EditorState.music-fade-x;
                    end-x: EditorState.music-end-x;
                    selected: EditorState.music-selected;
                    song-count: EditorState.songs.length;
                    viewport-width: flick.width;
                    show-focus: lane-focus.has-focus && EditorState.focus-visible;
                    pressed => {
                        EditorState.focus-visible = false;
                        lane-focus.focus();
                        EditorState.music-lane-pressed();
                    }
                    add-music => { EditorState.add-music(); }
                }
            }
            // Insertion point while dragging from the library.
            if EditorState.drop-marker >= 0 : Rectangle {
                x: EditorState.drop-marker-x * 1px - 1px;
                y: root.clip-top - Theme.space-xs;
                width: 3px;
                height: root.clip-height + Theme.space-s;
                background: Theme.accent;
            }
            // Playhead with a grab head in the ruler.
            Rectangle {
                x: EditorState.playhead-x * 1px - 1px;
                y: 0;
                width: 2px;
                height: parent.height;
                background: Theme.playhead;
            }
            Rectangle {
                x: EditorState.playhead-x * 1px - 6px;
                y: 0;
                width: 12px;
                height: 12px;
                border-radius: Theme.radius-s;
                background: Theme.playhead;
            }
        }
        if Shell.drag-over-timeline : Rectangle {
            background: Theme.drop-target;
            border-width: 2px;
            border-color: Theme.accent;
        }
    }
}



component Inspector inherits Rectangle {
    /// Keyboard: `T` jumps to the transition picker.
    public function focus-transition() { transition-picker.focus(); }
    background: Theme.surface-pane;
    width: 296px;
    // The music inspector covers the clip inspector while the music is
    // selected; the clip inspector stays in the tree so `T` can reach the
    // transition picker.
    ScrollView {
        visible: !EditorState.music-selected && EditorState.text-selected-count == 0;
        VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-xl;
            alignment: start;
            // Context line: what the controls below apply to.
            VerticalLayout {
                spacing: Theme.space-xs;
                Title {
                    text: EditorState.selected-count == 0
                        ? (EditorState.clip-count == 0 ? @tr("New clips") : @tr("All clips"))
                        : (EditorState.selected-count == 1 ? @tr("1 clip selected") : @tr("{} clips selected", EditorState.selected-count));
                }
                Caption {
                    text: EditorState.selected-count == 0
                        ? (EditorState.clip-count == 0 ? @tr("Defaults for clips you add") : @tr("Nothing selected: changes apply to all {} clips", EditorState.clip-count))
                        : @tr("Changes apply to the selection");
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
            if !EditorState.only-video-target : Section {
                title: EditorState.only-title-target ? @tr("Duration") : @tr("Photo duration");
                ValueSlider {
                    minimum: 0.5;
                    maximum: 20;
                    step: 0.5;
                    value <=> EditorState.duration-seconds;
                    value-text: round(EditorState.duration-seconds * 10) / 10 + " s";
                    label: @tr("Photo duration");
                    released(v) => { EditorState.duration-changed(v); }
                }
                ChoiceGroup {
                    label: @tr("Photo duration presets");
                    options: ["2 s", "3 s", "4 s", "5 s", "8 s"];
                    accessible-options: [@tr("2 seconds"), @tr("3 seconds"), @tr("4 seconds"), @tr("5 seconds"), @tr("8 seconds")];
                    selected-index: EditorState.duration-seconds == 2 ? 0 : EditorState.duration-seconds == 3 ? 1 : EditorState.duration-seconds == 4 ? 2 : EditorState.duration-seconds == 5 ? 3 : EditorState.duration-seconds == 8 ? 4 : -1;
                    changed(i) => {
                        EditorState.duration-seconds = i == 0 ? 2 : i == 1 ? 3 : i == 2 ? 4 : i == 3 ? 5 : 8;
                        EditorState.duration-changed(EditorState.duration-seconds);
                    }
                }
            }
            if EditorState.has-title-target : Section {
                title: @tr("Background");
                SwatchGroup {
                    label: @tr("Title background");
                    colors: Theme.title-backgrounds;
                    names: [@tr("Black"), @tr("Charcoal"), @tr("Blue"), @tr("Red"), @tr("White")];
                    selected-index <=> EditorState.title-background-index;
                    changed(i) => { EditorState.title-background-changed(i); }
                }
            }
            if EditorState.has-video-target : Section {
                title: @tr("Audio");
                Switch {
                    text: @tr("Mute");
                    checked <=> EditorState.muted;
                    toggled => { EditorState.muted-changed(self.checked); }
                }
                ValueSlider {
                    enabled: !EditorState.muted;
                    minimum: 0;
                    maximum: 200;
                    step: 5;
                    value <=> EditorState.volume-percent;
                    value-text: round(EditorState.volume-percent) + " %";
                    label: @tr("Volume");
                    released(v) => { EditorState.volume-changed(v); }
                }
                Caption { text: @tr("Drag the edges of a video clip to trim it."); wrap: word-wrap; overflow: clip; }
            }
            if !EditorState.only-title-target : Section {
                title: @tr("Framing");
                ChoiceGroup {
                    label: @tr("Framing");
                    options: [@tr("Fit inside"), @tr("Fill frame")];
                    accessible-options: [@tr("Fit inside, with bars"), @tr("Fill frame, cropped")];
                    selected-index <=> EditorState.fit-index;
                    changed(i) => { EditorState.fit-changed(i); }
                }
                ActionButton { text: @tr("Rotate 90°"); icon: Icons.arrow-rotate-clockwise; clicked => { EditorState.rotate-selected(); } }
            }
            Section {
                title: @tr("Transition into clip");
                transition-picker := ComboBox {
                    height: Theme.control-height;
                    model: [
                        @tr("Cut"), @tr("Cross dissolve"), @tr("Fade through black"), @tr("Fade through white"),
                        @tr("Slide left"), @tr("Slide right"), @tr("Slide up"), @tr("Slide down"),
                        @tr("Wipe left"), @tr("Wipe right"), @tr("Wipe up"), @tr("Wipe down"),
                        @tr("Zoom"),
                    ];
                    current-index <=> EditorState.transition-index;
                    selected => { EditorState.transition-changed(self.current-index, EditorState.transition-seconds); }
                    accessible-label: @tr("Transition into clip");
                }
                ValueSlider {
                    enabled: EditorState.transition-index != 0;
                    minimum: 0.2;
                    maximum: 3;
                    step: 0.1;
                    value <=> EditorState.transition-seconds;
                    value-text: round(EditorState.transition-seconds * 10) / 10 + " s";
                    label: @tr("Transition duration");
                    released(v) => { EditorState.transition-changed(EditorState.transition-index, v); }
                }
                if EditorState.transition-capped && EditorState.transition-index != 0 : Caption {
                    text: @tr("Shortened where clips are too short");
                    wrap: word-wrap;
                    overflow: clip;
                }
                ActionButton {
                    text: @tr("Shuffle transitions");
                    icon: Icons.arrow-shuffle;
                    enabled: EditorState.clip-count > 0;
                    clicked => { EditorState.shuffle-transitions(); }
                }
            }
            if EditorState.has-photo-target : Section {
                title: @tr("Motion");
                ComboBox {
                    height: Theme.control-height;
                    model: [@tr("None"), @tr("Zoom in"), @tr("Zoom out"), @tr("Pan left"), @tr("Pan right"), @tr("Pan up"), @tr("Pan down")];
                    current-index <=> EditorState.motion-index;
                    selected => { EditorState.motion-changed(self.current-index); }
                    accessible-label: @tr("Motion");
                }
                Caption {
                    text: EditorState.has-video-target ? @tr("Slow zoom or pan across photos. Applies to photos only.") : @tr("Slow zoom or pan across photos.");
                    wrap: word-wrap;
                    overflow: clip;
                }
                ActionButton {
                    text: @tr("Shuffle motion");
                    icon: Icons.arrow-shuffle;
                    enabled: EditorState.clip-count > 0;
                    clicked => { EditorState.shuffle-motion(); }
                }
            }
            Divider { }
            Section {
                title: @tr("Titles");
                ActionButton { text: @tr("Add opening title"); icon: Icons.text-t; clicked => { EditorState.add-opening-title(); } }
                ActionButton { text: @tr("Add closing card"); icon: Icons.text-t; clicked => { EditorState.add-closing-card(); } }
            }
            Section {
                title: @tr("Project");
                ChoiceGroup {
                    label: @tr("Orientation");
                    options: [@tr("Landscape 16:9"), @tr("Portrait 9:16")];
                    selected-index <=> EditorState.aspect-index;
                    changed(i) => { EditorState.aspect-changed(i); }
                }
            }
            Section {
                title: @tr("Timeline");
                ActionButton { text: @tr("Select all"); icon: Icons.select-all; enabled: EditorState.clip-count > 0; clicked => { EditorState.select-all(); } }
                ActionButton {
                    text: EditorState.selected-count > 1 ? @tr("Remove {} from timeline", EditorState.selected-count) : @tr("Remove from timeline");
                    icon: Icons.delete;
                    enabled: EditorState.selected-count > 0;
                    clicked => { EditorState.delete-selected(); }
                }
            }
        }
    }
    // Texts selected: the text inspector covers the clip inspector.
    if EditorState.text-selected-count > 0 && !EditorState.music-selected : ScrollView {
        VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-xl;
            alignment: start;
            VerticalLayout {
                spacing: Theme.space-xs;
                Title { text: EditorState.text-selected-count == 1 ? @tr("Text") : @tr("{} texts selected", EditorState.text-selected-count); }
                Caption { text: @tr("Drag it on the preview to move it; double-click to edit it there."); wrap: word-wrap; overflow: clip; }
            }
            Section {
                title: @tr("Text");
                TextEdit {
                    height: 64px;
                    wrap: word-wrap;
                    text <=> EditorState.text-content;
                    placeholder-text: EditorState.text-mixed ? @tr("Different texts") : "";
                    accessible-label: @tr("Text");
                    edited(t) => { EditorState.text-typed(t); }
                    changed has-focus => { if !self.has-focus { EditorState.text-typing-done(); } }
                }
            }
            Section {
                title: @tr("Font");
                FontPicker {
                    label: @tr("Font");
                    value: EditorState.text-font;
                    matches: EditorState.font-matches;
                    search(text) => { EditorState.text-font-search(text); }
                    picked(name) => { EditorState.text-font-changed(name); }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    // Size in points on a 1080-line frame.
                    SpinBox {
                        height: Theme.control-height;
                        minimum: 8;
                        maximum: 400;
                        value <=> EditorState.text-points;
                        edited(v) => { EditorState.text-points-changed(v); }
                        accessible-label: @tr("Font size in points");
                    }
                    Text {
                        text: @tr("pt");
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-xs;
                    alignment: start;
                    IconButton {
                        icon: Icons.text-bold;
                        tooltip: @tr("Bold");
                        checkable: true;
                        checked <=> EditorState.text-bold;
                        clicked => { EditorState.text-bold-changed(self.checked); }
                    }
                    IconButton {
                        icon: Icons.text-italic;
                        tooltip: @tr("Italic");
                        checkable: true;
                        checked <=> EditorState.text-italic;
                        clicked => { EditorState.text-italic-changed(self.checked); }
                    }
                    IconButton {
                        icon: Icons.text-underline;
                        tooltip: @tr("Underline");
                        checkable: true;
                        checked <=> EditorState.text-underline;
                        clicked => { EditorState.text-underline-changed(self.checked); }
                    }
                    Rectangle { width: Theme.space-m; }
                    IconChoiceGroup {
                        label: @tr("Alignment");
                        icons: [Icons.text-align-left, Icons.text-align-center, Icons.text-align-right];
                        labels: [@tr("Align left"), @tr("Centre"), @tr("Align right")];
                        selected-index <=> EditorState.text-align-index;
                        changed(i) => { EditorState.text-align-changed(i); }
                    }
                }
            }
            Section {
                title: @tr("Colour");
                SwatchGroup {
                    label: @tr("Text colour");
                    compact: true;
                    colors: Theme.text-colors;
                    names: [@tr("White"), @tr("Black"), @tr("Yellow"), @tr("Orange"), @tr("Red"), @tr("Pink"), @tr("Blue"), @tr("Green")];
                    selected-index <=> EditorState.text-color-index;
                    changed(i) => { EditorState.text-color-changed(i); }
                }
                Switch {
                    text: @tr("Shadow");
                    checked <=> EditorState.text-shadow;
                    toggled => { EditorState.text-shadow-changed(self.checked); }
                }
                Switch {
                    text: @tr("Box behind text");
                    checked <=> EditorState.text-box;
                    toggled => { EditorState.text-box-changed(self.checked); }
                }
                if EditorState.text-box : SwatchGroup {
                    label: @tr("Box colour");
                    compact: true;
                    colors: Theme.text-colors;
                    names: [@tr("White"), @tr("Black"), @tr("Yellow"), @tr("Orange"), @tr("Red"), @tr("Pink"), @tr("Blue"), @tr("Green")];
                    selected-index <=> EditorState.text-box-color-index;
                    changed(i) => { EditorState.text-box-color-changed(i); }
                }
            }
            Section {
                title: @tr("Timing");
                SecondaryText { text: @tr("Duration"); }
                ValueSlider {
                    minimum: 0.5;
                    maximum: 30;
                    step: 0.5;
                    value <=> EditorState.text-duration;
                    value-text: round(EditorState.text-duration * 10) / 10 + " s";
                    label: @tr("Text duration");
                    released(v) => { EditorState.text-duration-changed(v); }
                }
                Caption { text: @tr("Drag the text's block on the timeline to move it; drag its edges to change when it starts or ends."); wrap: word-wrap; overflow: clip; }
            }
            Section {
                title: @tr("Animation in");
                ComboBox {
                    height: Theme.control-height;
                    model: [@tr("None"), @tr("Fade"), @tr("Slide left"), @tr("Slide right"), @tr("Slide up"), @tr("Slide down"), @tr("Wipe left"), @tr("Wipe right"), @tr("Wipe up"), @tr("Wipe down"), @tr("Zoom")];
                    current-index <=> EditorState.text-enter-index;
                    selected => { EditorState.text-enter-changed(self.current-index, EditorState.text-enter-seconds); }
                    accessible-label: @tr("Animation in");
                }
                ValueSlider {
                    enabled: EditorState.text-enter-index != 0;
                    minimum: 0.1;
                    maximum: 3;
                    step: 0.1;
                    value <=> EditorState.text-enter-seconds;
                    value-text: round(EditorState.text-enter-seconds * 10) / 10 + " s";
                    label: @tr("Animation in duration");
                    released(v) => { EditorState.text-enter-changed(EditorState.text-enter-index, v); }
                }
            }
            Section {
                title: @tr("Animation out");
                ComboBox {
                    height: Theme.control-height;
                    model: [@tr("None"), @tr("Fade"), @tr("Slide left"), @tr("Slide right"), @tr("Slide up"), @tr("Slide down"), @tr("Wipe left"), @tr("Wipe right"), @tr("Wipe up"), @tr("Wipe down"), @tr("Zoom")];
                    current-index <=> EditorState.text-exit-index;
                    selected => { EditorState.text-exit-changed(self.current-index, EditorState.text-exit-seconds); }
                    accessible-label: @tr("Animation out");
                }
                ValueSlider {
                    enabled: EditorState.text-exit-index != 0;
                    minimum: 0.1;
                    maximum: 3;
                    step: 0.1;
                    value <=> EditorState.text-exit-seconds;
                    value-text: round(EditorState.text-exit-seconds * 10) / 10 + " s";
                    label: @tr("Animation out duration");
                    released(v) => { EditorState.text-exit-changed(EditorState.text-exit-index, v); }
                }
            }
            ActionButton {
                text: EditorState.text-selected-count > 1 ? @tr("Remove {} texts", EditorState.text-selected-count) : @tr("Remove text");
                icon: Icons.delete;
                clicked => { EditorState.delete-selected(); }
            }
        }
    }
    if EditorState.music-selected : ScrollView {
        VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-xl;
            alignment: start;
            VerticalLayout {
                spacing: Theme.space-xs;
                Title { text: @tr("Music"); }
                Caption { text: @tr("Plays under the whole slideshow"); wrap: word-wrap; overflow: clip; }
            }
            Section {
                title: @tr("Songs");
                if EditorState.songs.length == 0 : Caption { text: @tr("No songs yet. Add music or drop audio files from the library."); wrap: word-wrap; overflow: clip; }
                for song[i] in EditorState.songs : SongRow {
                    title: song.title;
                    duration-text: song.duration-text;
                    first: i == 0;
                    last: i == EditorState.songs.length - 1;
                    move-up => { EditorState.song-move(i, true); }
                    move-down => { EditorState.song-move(i, false); }
                    remove => { EditorState.song-remove(i); }
                }
                ActionButton { text: @tr("Add music…"); icon: Icons.add; clicked => { EditorState.add-music(); } }
                ActionButton {
                    text: @tr("Remove all songs");
                    icon: Icons.delete;
                    enabled: EditorState.songs.length > 0;
                    clicked => { EditorState.remove-all-songs(); }
                }
            }
            Section {
                title: @tr("Volume");
                ValueSlider {
                    minimum: 0;
                    maximum: 200;
                    step: 5;
                    value <=> EditorState.music-volume;
                    value-text: round(EditorState.music-volume) + " %";
                    label: @tr("Music volume");
                    released(v) => { EditorState.music-volume-changed(v); }
                }
                Switch {
                    text: @tr("Lower under video sound");
                    checked <=> EditorState.music-duck;
                    toggled => { EditorState.music-duck-changed(self.checked); }
                }
                Caption { text: @tr("Video and music add up to full volume: a video at 20 % leaves 80 % music."); wrap: word-wrap; overflow: clip; }
            }
            Section {
                title: @tr("Fades");
                SecondaryText { text: @tr("Fade in"); }
                ValueSlider {
                    minimum: 0;
                    maximum: 10;
                    step: 0.5;
                    value <=> EditorState.music-fade-in;
                    value-text: round(EditorState.music-fade-in * 10) / 10 + " s";
                    label: @tr("Fade in");
                    released(v) => { EditorState.music-fades-changed(v, EditorState.music-fade-out); }
                }
                SecondaryText { text: @tr("Fade out"); }
                ValueSlider {
                    minimum: 0;
                    maximum: 10;
                    step: 0.5;
                    value <=> EditorState.music-fade-out;
                    value-text: round(EditorState.music-fade-out * 10) / 10 + " s";
                    label: @tr("Fade out");
                    released(v) => { EditorState.music-fades-changed(EditorState.music-fade-in, v); }
                }
            }
            Section {
                title: @tr("Length");
                // Short label: std Switch text cannot wrap; the detail goes below.
                Switch {
                    text: @tr("Loop");
                    checked <=> EditorState.music-loop;
                    toggled => { EditorState.music-loop-changed(self.checked); }
                    accessible-label: @tr("Loop the songs until the slideshow ends");
                }
                Caption { text: @tr("Repeats the songs until the slideshow ends."); wrap: word-wrap; overflow: clip; }
                Caption { text: @tr("Music {} · Slideshow {}", EditorState.music-length-text, EditorState.show-length-text); wrap: word-wrap; overflow: clip; }
                ActionButton {
                    text: @tr("Fit slideshow to music");
                    enabled: EditorState.can-fit-music;
                    clicked => { EditorState.fit-to-music(); }
                }
                Caption { text: @tr("Gives every photo the same duration so the slideshow is as long as the songs."); wrap: word-wrap; overflow: clip; }
            }
        }
    }
}

component ExportDialog inherits DialogFrame {
    title: @tr("Export video");
    dialog-width: 480px;
    dismissed => { if EditorState.export-status != 1 { EditorState.export-open = false; } }
    accepted => { if EditorState.export-status != 1 { EditorState.export-start(); } }
    Section {
        title: @tr("Resolution");
        ChoiceGroup {
            label: @tr("Resolution");
            options: [@tr("Full HD (1080p)"), @tr("4K (2160p)")];
            enabled: EditorState.export-status != 1;
            selected-index <=> EditorState.export-resolution-index;
        }
    }
    Section {
        title: @tr("Quality");
        ChoiceGroup {
            label: @tr("Quality");
            options: [@tr("Good"), @tr("Better"), @tr("Best")];
            enabled: EditorState.export-status != 1;
            selected-index <=> EditorState.export-quality-index;
        }
    }
    Switch { text: @tr("Optimize for YouTube"); checked <=> EditorState.export-youtube; enabled: EditorState.export-status != 1; }
    Caption { text: @tr("HDR export becomes available once HDR sources are supported."); wrap: word-wrap; overflow: clip; }
    if EditorState.export-status == 1 : ProgressIndicator { progress: EditorState.export-progress; }
    if EditorState.export-status != 0 : HorizontalLayout {
        spacing: Theme.space-s;
        if EditorState.export-status != 1 : Icon {
            source: EditorState.export-status == 2 ? Icons.checkmark-circle : Icons.error-circle;
            color: EditorState.export-status == 2 ? Theme.success : Theme.danger;
        }
        SecondaryText {
            text: EditorState.export-status == 1 ? @tr("Exporting… {}%", round(EditorState.export-progress * 100))
                : EditorState.export-status == 2 ? @tr("Saved to {}", EditorState.export-message)
                : @tr("Export failed: {}", EditorState.export-message);
            color: Theme.text;
            wrap: word-wrap;
            overflow: clip;
            horizontal-stretch: 1;
        }
    }
    DialogButtons {
        macos: Shell.macos;
        primary-text: @tr("Export…");
        primary-visible: EditorState.export-status != 1;
        secondary-text: EditorState.export-status == 1 ? @tr("Cancel") : @tr("Close");
        primary => { EditorState.export-start(); }
        secondary => { if EditorState.export-status == 1 { EditorState.export-cancel(); } else { EditorState.export-open = false; } }
    }
}

export component EditorPage inherits Rectangle {
    /// Width of the preview column (window minus the library pane and the
    /// 296 px inspector), for the compact toolbar. From the window width: a
    /// binding on this page's own width would loop through its layout.
    property <length> editor-width: Shell.window-width - (Shell.library-visible ? max(280px, min(Shell.library-width, Shell.library-max-width)) + 8px : 0px) - 297px;
    background: Theme.surface-window;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.meta || event.modifiers.control) && (event.text == "z" || event.text == "Z") {
                if event.modifiers.shift { EditorState.redo(); } else { EditorState.undo(); }
                return accept;
            }
            if (event.modifiers.meta || event.modifiers.control) && event.text == "y" { EditorState.redo(); return accept; }
            // ↑/↓ and Alt+←/→ work anywhere in the editor and move focus into the strip.
            // Texts selected: arrows nudge them, Enter edits in place.
            if EditorState.text-selected-count > 0 {
                if event.text == Key.LeftArrow { EditorState.text-nudge(-1, 0, event.modifiers.shift); return accept; }
                if event.text == Key.RightArrow { EditorState.text-nudge(1, 0, event.modifiers.shift); return accept; }
                if event.text == Key.UpArrow { EditorState.text-nudge(0, -1, event.modifiers.shift); return accept; }
                if event.text == Key.DownArrow { EditorState.text-nudge(0, 1, event.modifiers.shift); return accept; }
                if event.text == Key.Return { EditorState.edit-selected-text(); return accept; }
            }
            if (event.modifiers.meta || event.modifiers.control) && (event.text == "t" || event.text == "T") { EditorState.add-text(); return accept; }
            if strip.nav-key(event) { strip.focus-strip(); return accept; }
            if (event.modifiers.meta || event.modifiers.control) && event.text == "a" { EditorState.select-all(); return accept; }
            if event.text == Key.Delete || event.text == Key.Backspace { EditorState.delete-selected(); return accept; }
            if event.text == Key.Space { EditorState.toggle-play(); return accept; }
            if event.text == "k" { EditorState.pause(); return accept; }
            if event.text == "l" { EditorState.play(); return accept; }
            if event.text == "j" { EditorState.step-seconds(-1); return accept; }
            if event.text == Key.LeftArrow { EditorState.step-frames(event.modifiers.shift ? -10 : -1); return accept; }
            if event.text == Key.RightArrow { EditorState.step-frames(event.modifiers.shift ? 10 : 1); return accept; }
            if event.text == Key.Home { EditorState.scrub(0); return accept; }
            if event.text == "t" && !event.modifiers.control && !event.modifiers.meta {
                if EditorState.music-selected { EditorState.clear-selection(); }
                inspector.focus-transition();
                return accept;
            }
            if event.text == Key.End { EditorState.scrub(EditorState.strip-width); return accept; }
            if event.text == Key.Escape { EditorState.clear-selection(); return accept; }
            return reject;
        }

        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                // Toolbar
                Bar {
                    background: Theme.surface-pane;
                    side-padding: Theme.space-s;
                        IconButton {
                            icon: Shell.library-visible ? Icons.panel-left-contract : Icons.panel-left-expand;
                            tooltip: Shell.library-visible ? @tr("Hide library") : @tr("Show library");
                            clicked => { Shell.library-visible = !Shell.library-visible; }
                        }
                        IconButton { icon: Icons.arrow-undo; tooltip: Shell.macos ? @tr("Undo (⌘Z)") : @tr("Undo (Ctrl+Z)"); enabled: EditorState.can-undo; clicked => { EditorState.undo(); } }
                        IconButton { icon: Icons.arrow-redo; tooltip: Shell.macos ? @tr("Redo (⇧⌘Z)") : @tr("Redo (Ctrl+Shift+Z)"); enabled: EditorState.can-redo; clicked => { EditorState.redo(); } }
                        IconButton { icon: Icons.text-t; tooltip: Shell.macos ? @tr("Add text (⌘T)") : @tr("Add text (Ctrl+T)"); clicked => { EditorState.add-text(); } }
                        BodyText {
                            text: EditorState.project-title + (EditorState.dirty ? " •" : "");
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            min-width: 0;
                            accessible-label: @tr("Project title");
                        }
                        // Narrow editor (900 px windows): the export button keeps its icon only.
                        if root.editor-width >= 520px : ActionButton { text: @tr("Export…"); icon: Icons.share; primary: true; enabled: EditorState.clip-count > 0; clicked => { EditorState.export-open = true; } }
                        if root.editor-width < 520px : IconButton { icon: Icons.share; primary: true; tooltip: @tr("Export…"); enabled: EditorState.clip-count > 0; clicked => { EditorState.export-open = true; } }
                        IconButton { icon: Icons.settings; tooltip: @tr("Settings"); enabled: !EditorState.export-open; clicked => { Shell.settings-open = true; } }
                }
                Divider { }
                // Preview
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-canvas;
                    Image {
                        source: EditorState.preview;
                        image-fit: contain;
                        width: parent.width - 2 * Theme.space-l;
                        height: parent.height - 2 * Theme.space-l;
                        x: Theme.space-l;
                        y: Theme.space-l;
                    }
                    // WYSIWYG text editing over the picture.
                    TextOverlay {
                        width: parent.width - 2 * Theme.space-l;
                        height: parent.height - 2 * Theme.space-l;
                        x: Theme.space-l;
                        y: Theme.space-l;
                    }
                    if EditorState.clip-count == 0 && EditorState.preview-texts.length == 0 : EmptyState {
                        width: min(parent.width, 480px);
                        x: (parent.width - self.width) / 2;
                        height: parent.height;
                        icon: Icons.filmstrip;
                        title: @tr("Your slideshow is empty");
                        description: @tr("Double-click items in the library or drag them onto the timeline below. Everything you change can be undone.");
                        action-text: @tr("Add all from library");
                        action-enabled: LibraryState.total-count > 0;
                        action => { LibraryState.add-all-to-timeline(); }
                    }
                }
                Divider { }
                // Transport
                Bar {
                    bar-height: Theme.bar-height;
                    background: Theme.surface-pane;
                    side-padding: Theme.space-s;
                        IconButton {
                            icon: EditorState.playing ? Icons.pause : Icons.play;
                            tooltip: EditorState.playing ? @tr("Pause (Space)") : @tr("Play (Space)");
                            enabled: EditorState.clip-count > 0;
                            clicked => { EditorState.toggle-play(); }
                        }
                        // The time read-out never shrinks; the status message gives way.
                        SecondaryText { text: EditorState.time-text + " / " + EditorState.total-text; color: Theme.text; min-width: self.preferred-width; }
                        // Result of the last bulk action ("Shuffled transitions on 12 clips");
                        // Rust clears it after a few seconds.
                        Caption {
                            text: EditorState.status-text;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            overflow: elide;
                            min-width: 0;
                            accessible-role: text;
                        }
                        // Timeline zoom: icons at both ends label the slider.
                        Icon { source: Icons.zoom-out; size: Theme.icon-s; color: Theme.text-secondary; }
                        // Shrinks before anything else in narrow windows, so the
                        // transport never pushes the inspector out (900 px minimum).
                        Slider {
                            preferred-width: 120px;
                            min-width: 64px;
                            horizontal-stretch: 0;
                            minimum: 10;
                            maximum: 200;
                            value <=> EditorState.pixels-per-second;
                            changed(v) => { EditorState.zoom-changed(v); }
                            accessible-label: @tr("Timeline zoom");
                            Tooltip { text: @markdown("\{@tr("Timeline zoom")}"); }
                        }
                        Icon { source: Icons.zoom-in; size: Theme.icon-s; color: Theme.text-secondary; }
                }
                Divider { }
                // Timeline strip
                strip := TimelineStrip { }
            }
            VDivider { }
            inspector := Inspector { }
        }
    }
    if EditorState.export-open : ExportDialog { }

    /// On-screen rectangle of the timeline strip, for cross-panel drops.
    out property <StripRect> strip-rect: strip.rect;
}
