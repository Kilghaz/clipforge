// Component gallery: every ClipForge component in every state, on one
// page, for the visual pass (docs/ux/DESIGN.md §5). Rendered by
// `cargo run -p clipforge-app --bin screenshot -- gallery` at 2× scale.
// Not part of the app; nothing here is translated (labels are for us).
import { Button, ComboBox, CheckBox, Slider, LineEdit, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton, ChoiceButton, ChoiceGroup, SearchField, Bar, Section, SectionLabel, Caption, BodyText, Title, SecondaryText, Divider, VDivider, Badge, EmptyState, DialogFrame, DialogButtons } from "components.slint";
import { CellView, KindBadge, MediaCell } from "library.slint";
import { ClipView, ValueSlider, TimelineClip, TimelineStrip, EditorState } from "editor.slint";

component Row inherits VerticalLayout {
    in property <string> title;
    spacing: Theme.space-s;
    alignment: start;
    Caption { text: root.title; }
    HorizontalLayout {
        spacing: Theme.space-m;
        alignment: start;
        @children
    }
}

/// Alignment guides: a 32 px box with a centre cross, to check centring.
component Guide inherits Rectangle {
    width: Theme.control-height;
    height: Theme.control-height;
    border-width: 1px;
    border-color: Theme.danger;
    Rectangle { x: parent.width / 2; y: 0; width: 1px; height: parent.height; background: Theme.danger; }
    Rectangle { x: 0; y: parent.height / 2; width: parent.width; height: 1px; background: Theme.danger; }
    @children
}

export component GalleryWindow inherits Window {
    // Body size for everything without an explicit size, so std widgets
    // (Button behind ActionButton, ComboBox, Switch, LineEdit) match our
    // own controls. Without it Slint falls back to 12 px (DESIGN.md §2).
    default-font-size: Theme.font-body;
    in property <image> sample;
    background: Theme.surface-window;
    init => { Palette.color-scheme = ColorScheme.dark; }

    VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-xl;
        alignment: start;

        Row {
            title: "IconButton: default, primary, checked, disabled, disabled-primary; guide shows the centre";
            IconButton { icon: Icons.settings; tooltip: "Settings"; }
            IconButton { icon: Icons.share; tooltip: "Export"; primary: true; }
            IconButton { icon: Icons.speaker-mute; tooltip: "Mute"; checkable: true; checked: true; }
            IconButton { icon: Icons.arrow-undo; tooltip: "Undo"; enabled: false; }
            IconButton { icon: Icons.play; tooltip: "Play"; primary: true; enabled: false; }
            IconButton { icon: Icons.dismiss; tooltip: "Clear selection (quiet)"; quiet: true; }
            Guide { IconButton { icon: Icons.add; tooltip: "Add"; background: transparent; border-color: transparent; } }
            Guide { Icon { source: Icons.folder-add; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
        }
        Row {
            title: "ActionButton: text, icon+text, primary, primary icon+text, disabled; ChoiceButton selected / default / disabled; std Button for comparison";
            ActionButton { text: "Add all"; }
            ActionButton { text: "Show in folder"; icon: Icons.folder-open; }
            ActionButton { text: "Add to timeline"; primary: true; }
            ActionButton { text: "Export…"; icon: Icons.share; primary: true; }
            ActionButton { text: "Remove"; icon: Icons.delete; enabled: false; }
            ActionButton { text: "Export…"; icon: Icons.share; primary: true; enabled: false; }
            ActionButton { text: "Aus Zeitleiste entfernen"; icon: Icons.delete; }
            ChoiceButton { text: "4 s"; selected: true; }
            ChoiceButton { text: "Fill frame"; }
            ChoiceButton { text: "8 s"; enabled: false; }
            ChoiceButton { text: "4 s"; selected: true; enabled: false; }
            Button { text: "std Button"; }
            Button { text: "std icon"; icon: Icons.save; colorize-icon: true; }
        }
        Row {
            title: "SearchField empty / with text / disabled; std ComboBox, CheckBox, Slider, ProgressIndicator at control-height";
            SearchField { width: 200px; placeholder: "Search the library"; }
            SearchField { width: 200px; placeholder: "Search the library"; text: "holiday"; }
            SearchField { width: 160px; placeholder: "Search"; text: "x"; enabled: false; }
            CheckBox { text: "Unchecked"; }
            CheckBox { text: "Disabled"; enabled: false; }
            ComboBox { height: Theme.control-height; width: 120px; model: ["Disabled"]; enabled: false; }
            ComboBox { height: Theme.control-height; width: 160px; model: ["Fit inside (bars)", "Fill frame (crop)"]; }
            CheckBox { text: "Mute"; checked: true; }
            Slider { width: 160px; value: 40; }
            ProgressIndicator { width: 160px; progress: 0.42; }
            ProgressIndicator { width: 32px; indeterminate: true; }
        }
        Row {
            title: "Bar 48 px (toolbar) and Bar 40 px (dense: search row, transport): everything on one centre line";
            Rectangle {
                width: 720px;
                background: Theme.surface-pane;
                Bar {
                    width: parent.width;
                    IconButton { icon: Icons.panel-left-contract; tooltip: "Hide library"; }
                    IconButton { icon: Icons.arrow-undo; tooltip: "Undo"; }
                    BodyText { text: "Summer holiday •"; horizontal-stretch: 1; horizontal-alignment: center; }
                    ActionButton { text: "Export…"; icon: Icons.share; primary: true; }
                    IconButton { icon: Icons.settings; tooltip: "Settings"; }
                    Caption { text: "12 items"; }
                    ComboBox { height: Theme.control-height; width: 120px; model: ["Date"]; }
                }
                Rectangle { y: parent.height / 2; height: 1px; width: parent.width; background: Theme.danger; }
            }
            Rectangle {
                width: 420px;
                background: Theme.surface-pane;
                Bar {
                    width: parent.width;
                    bar-height: Theme.bar-height;
                    side-padding: Theme.space-s;
                    IconButton { icon: Icons.play; tooltip: "Play"; }
                    SecondaryText { text: "00:00:07 / 00:00:26"; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Icon { source: Icons.zoom-out; size: Theme.icon-s; color: Theme.text-secondary; }
                    Slider { width: 100px; value: 40; }
                    Icon { source: Icons.zoom-in; size: Theme.icon-s; color: Theme.text-secondary; }
                }
                Rectangle { y: parent.height / 2; height: 1px; width: parent.width; background: Theme.danger; }
            }
        }
        Row {
            title: "Text roles: title 16 / body 14 / secondary 12 / caption 11, SectionLabel; Divider";
            Title { text: "Title 16 semibold"; }
            BodyText { text: "Body 14"; }
            SecondaryText { text: "Secondary 12"; }
            Caption { text: "Caption 11"; }
            SectionLabel { text: "Section label"; }
            Rectangle { width: 120px; height: Theme.control-height; Divider { y: parent.height / 2; width: parent.width; } }
            Rectangle { width: Theme.control-height; height: Theme.control-height; VDivider { x: parent.width / 2; height: parent.height; } }
        }
        Row {
            title: "DialogFrame (scaled preview, 480 × 200) with DialogButtons";
            Rectangle {
                width: 560px;
                height: 240px;
                clip: true;
                DialogFrame {
                    width: parent.width;
                    height: parent.height;
                    title: "Export video";
                    dialog-width: 480px;
                    dialog-height: 200px;
                    BodyText { text: "Dialog body content"; }
                    Rectangle { vertical-stretch: 1; }
                    DialogButtons { macos: false; primary-text: "Export…"; secondary-text: "Cancel"; }
                }
            }
        }
        Row {
            title: "Badges: video, audio, cloud, failed, muted; HDR tag";
            KindBadge { kind: 1; }
            KindBadge { kind: 2; }
            KindBadge { kind: 0; cloud: true; }
            KindBadge { kind: 0; failed: true; }
            Badge { icon: Icons.speaker-mute; label: "Muted"; }
            Badge { text: "HDR"; label: "High dynamic range"; }
        }
        Row {
            title: "Library cells: photo, selected, video, audio (no thumb), pending, failed, cloud; selected + keyboard focus, focus only";
            CellView { cell: { index: 0, id: "a", title: "IMG_4021.jpg", subtitle: "12 Jul 2026", image: root.sample, has-image: true, kind: 0 }; }
            CellView { cell: { index: 1, id: "b", title: "IMG_4022.jpg", subtitle: "12 Jul 2026", image: root.sample, has-image: true, kind: 0, selected: true }; }
            CellView { cell: { index: 2, id: "c", title: "Clip 5.mov", subtitle: "0:14 · 4K", image: root.sample, has-image: true, kind: 1 }; }
            CellView { cell: { index: 3, id: "d", title: "Soundtrack.m4a", subtitle: "3:42", kind: 2 }; }
            CellView { cell: { index: 4, id: "e", title: "IMG_4023.jpg", subtitle: "12 Jul 2026", kind: 0, pending: true }; }
            CellView { cell: { index: 5, id: "f", title: "broken.jpg", subtitle: "", kind: 0, failed: true }; }
            CellView { cell: { index: 6, id: "g", title: "IMG_4024.jpg", subtitle: "12 Jul 2026", image: root.sample, has-image: true, kind: 0, cloud: true }; }
            CellView { show-focus: true; cell: { index: 7, id: "h", title: "IMG_4025.jpg", subtitle: "12 Jul 2026", image: root.sample, has-image: true, kind: 0, selected: true, focused: true }; }
            CellView { show-focus: true; cell: { index: 8, id: "i", title: "IMG_4026.jpg", subtitle: "12 Jul 2026", image: root.sample, has-image: true, kind: 0, focused: true }; }
        }
        Row {
            title: "Timeline clips (100 px): photo, selected photo with dissolve, video, muted video, no thumb; selected + keyboard focus, focus only";
            ClipView { width: 160px; height: 100px; item: { index: 0, id: "a", title: "IMG_4021.jpg", thumb: root.sample, has-thumb: true, width: 160, duration-text: "4.0 s" }; }
            ClipView { width: 160px; height: 100px; item: { index: 1, id: "b", title: "IMG_4022.jpg", thumb: root.sample, has-thumb: true, width: 160, overlap: 40, selected: true, transition: 1, duration-text: "4.0 s" }; }
            ClipView { width: 220px; height: 100px; item: { index: 2, id: "c", title: "Clip 2.mov", thumb: root.sample, has-thumb: true, width: 220, is-video: true, duration-text: "0:06" }; }
            ClipView { width: 220px; height: 100px; item: { index: 3, id: "d", title: "Clip 4.mov", thumb: root.sample, has-thumb: true, width: 220, is-video: true, muted: true, transition: 2, overlap: 30, duration-text: "0:06" }; }
            ClipView { width: 120px; height: 100px; item: { index: 4, id: "e", title: "IMG_4099.jpg", width: 120, duration-text: "4.0 s" }; }
            ClipView { width: 160px; height: 100px; show-focus: true; item: { index: 5, id: "f", title: "IMG_4100.jpg", thumb: root.sample, has-thumb: true, width: 160, selected: true, focused: true, duration-text: "4.0 s" }; }
            ClipView { width: 160px; height: 100px; show-focus: true; item: { index: 6, id: "g", title: "IMG_4101.jpg", thumb: root.sample, has-thumb: true, width: 160, focused: true, duration-text: "4.0 s" }; }
        }
        Row {
            title: "Timeline clips, M4: moving photo (no transition), moving photo with slide, video with wipe (movement overlay), selected moving photo with zoom";
            ClipView { width: 160px; height: 100px; item: { index: 0, id: "f", title: "IMG_4101.jpg", thumb: root.sample, has-thumb: true, width: 160, moving: true, duration-text: "4.0 s" }; }
            ClipView { width: 160px; height: 100px; item: { index: 1, id: "g", title: "IMG_4102.jpg", thumb: root.sample, has-thumb: true, width: 160, overlap: 40, transition: 4, moving: true, duration-text: "4.0 s" }; }
            ClipView { width: 220px; height: 100px; item: { index: 2, id: "h", title: "Clip 6.mov", thumb: root.sample, has-thumb: true, width: 220, is-video: true, overlap: 30, transition: 8, duration-text: "0:06" }; }
            ClipView { width: 160px; height: 100px; item: { index: 3, id: "i", title: "IMG_4104.jpg", thumb: root.sample, has-thumb: true, width: 160, overlap: 40, transition: 12, moving: true, selected: true, duration-text: "4.0 s" }; }
        }
        Row {
            title: "Section + ValueSlider (inspector form), 280 px wide; EmptyState; DialogButtons Windows / macOS";
            Rectangle {
                width: 280px;
                background: Theme.surface-pane;
                VerticalLayout {
                    padding: Theme.space-l;
                    spacing: Theme.space-xl;
                    Section {
                        title: "Photo duration";
                        ValueSlider { minimum: 0.5; maximum: 20; step: 0.5; value: 4; value-text: "4 s"; label: "Photo duration"; }
                        ChoiceGroup { label: "Photo duration presets"; options: ["2 s", "3 s", "4 s", "5 s", "8 s"]; selected-index: 2; }
                    }
                    Section {
                        title: "Volume (disabled while muted)";
                        ValueSlider { enabled: false; minimum: 0; maximum: 200; step: 5; value: 100; value-text: "100 %"; label: "Volume"; }
                    }
                    Section {
                        title: "Framing";
                        ChoiceGroup { label: "Framing"; options: ["Fit inside", "Fill frame"]; selected-index: 0; }
                        ActionButton { text: "Rotate 90°"; icon: Icons.arrow-rotate-clockwise; }
                    }
                    Section {
                        title: "Motion (M4)";
                        ComboBox { height: Theme.control-height; model: ["Zoom in"]; current-index: 0; }
                        Caption { text: "Slow zoom or pan across photos. Applies to photos only."; wrap: word-wrap; overflow: clip; }
                        ActionButton { text: "Shuffle motion"; icon: Icons.arrow-shuffle; }
                    }
                }
            }
            Rectangle {
                width: 320px;
                background: Theme.surface-window;
                EmptyState {
                    width: parent.width;
                    icon: Icons.image-multiple;
                    title: "Your library is empty";
                    description: "Add the photos, videos and music for your slideshow.";
                    action-text: "Add folder…";
                    secondary-text: "Add files…";
                }
            }
            Rectangle {
                width: 320px;
                background: Theme.surface-window;
                EmptyState {
                    width: parent.width;
                    icon: Icons.search;
                    title: "Nothing matches your search";
                    description: "Try another word, or clear the search and filter.";
                    action-text: "Clear search and filter";
                }
            }
            VerticalLayout {
                spacing: Theme.space-m;
                alignment: start;
                Rectangle { width: 320px; height: Theme.control-height; DialogButtons { width: parent.width; macos: false; primary-text: "Export…"; secondary-text: "Cancel"; } }
                Rectangle { width: 320px; height: Theme.control-height; DialogButtons { width: parent.width; macos: true; primary-text: "Export…"; secondary-text: "Cancel"; } }
                Rectangle { width: 320px; height: Theme.control-height; DialogButtons { width: parent.width; macos: false; primary-text: "Export…"; primary-enabled: false; secondary-text: "Cancel"; } }
                Rectangle { width: 320px; height: Theme.control-height; DialogButtons { width: parent.width; macos: false; primary-text: "Close"; } }
            }
        }
        Row {
            title: "TimelineStrip: ruler with zoom-aware labels, clips, playhead with grab head, accent drop marker at 0:05";
            Rectangle {
                width: 900px;
                clip: true;
                init => {
                    EditorState.pixels-per-second = 60;
                    EditorState.strip-width = 700;
                    EditorState.playhead-x = 150;
                    EditorState.drop-marker = 1;
                    EditorState.drop-marker-x = 300;
                    EditorState.clips = [
                        { index: 0, id: "a", title: "IMG_4021.jpg", thumb: root.sample, has-thumb: true, x: 8, width: 240, duration-text: "4.0 s" },
                        { index: 1, id: "b", title: "Clip 2.mov", thumb: root.sample, has-thumb: true, x: 252, width: 360, overlap: 60, selected: true, transition: 1, is-video: true, duration-text: "0:06" },
                    ];
                }
                height: strip-preview.height;
                strip-preview := TimelineStrip { width: parent.width; }
            }
        }
    }
}
