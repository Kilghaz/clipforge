/// Window-level layout and cross-panel drag state.
export global Shell {
    /// True on macOS; dialogs then use the macOS button order.
    in-out property <bool> macos;
    in-out property <bool> library-visible: true;
    in-out property <length> library-width: 380px;
    /// Upper bound for the library pane so the editor keeps ~640 px; set from
    /// the window's `changed width` (a binding on root.width would loop).
    in-out property <length> library-max-width: 10000px;
    /// Window width, set from `changed width` like `library-max-width`, so
    /// panes can adapt without a layout binding loop.
    in-out property <length> window-width: 1400px;
    in-out property <bool> settings-open: false;

    /// Drag from the library towards the timeline (window coordinates).
    in-out property <bool> drag-active;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <int> drag-count;
    in-out property <bool> drag-over-timeline;
}
